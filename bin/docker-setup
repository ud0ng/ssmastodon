#!/usr/bin/env bash
# Docker Compose 로 새 서버를 설치한다. (mastodon:setup 대신 사용)
#
#   cd ~/mastodon && docker compose build && bin/docker-setup
#
# 하는 일
#   1. 비밀 키를 만들고 .env.production 을 저장 (DB=db, Redis=redis, 메일=외부 SMTP, 기본값 Brevo)
#   2. DB 생성 → 스키마 → 마이그레이션 → seed (관리자 역할 포함)
#   3. 멀티계정 OAuth 클라이언트 생성
#   4. 관리자(Owner) 계정 생성
#
# 묻는 값은 환경변수로 미리 줄 수도 있다:
#   LOCAL_DOMAIN, SMTP_SERVER, SMTP_LOGIN, SMTP_PASSWORD, SMTP_FROM_ADDRESS, ADMIN_USERNAME, ADMIN_EMAIL
#
# 이미 .env.production 이 있으면 멈춘다. (비밀 키를 다시 만들면 모두 로그아웃되고 암호화된 데이터가 깨진다)

set -euo pipefail

cd "$(dirname "$0")/.."

ENV_FILE=.env.production

if [[ -e "$ENV_FILE" ]]; then
  echo "$ENV_FILE 이(가) 이미 있습니다. 이미 설치된 서버라면 이 스크립트를 다시 실행하지 마세요." >&2
  exit 1
fi

ask() {
  local var="$1" label="$2" default="${3:-}" value="${!1:-}"
  while [[ -z "$value" ]]; do
    if [[ -n "$default" ]]; then
      read -r -p "$label [$default]: " value
      value="${value:-$default}"
    else
      read -r -p "$label: " value
    fi
  done
  printf -v "$var" '%s' "$value"
}

ask_secret() {
  local var="$1" label="$2" value="${!1:-}"
  while [[ -z "$value" ]]; do
    read -r -s -p "$label: " value
    echo
  done
  printf -v "$var" '%s' "$value"
}

# run_web [VAR=value ...] -- command ...
run_web() {
  local envs=()
  while [[ "$1" != '--' ]]; do
    envs+=(-e "$1")
    shift
  done
  shift
  docker compose run --rm -T "${envs[@]}" web "$@"
}

echo '== 서버 정보 =='
ask LOCAL_DOMAIN '서버 도메인 (바꿀 수 없음)'
ask SMTP_SERVER 'SMTP 서버' 'smtp-relay.brevo.com'
ask SMTP_LOGIN 'SMTP 로그인 (Brevo는 ...@smtp-brevo.com 형태)'
ask_secret SMTP_PASSWORD 'SMTP 비밀번호 (Brevo는 SMTP 키, 입력이 화면에 안 보입니다)'
SMTP_PASSWORD="${SMTP_PASSWORD// /}"
ask SMTP_FROM_ADDRESS '보내는 주소' "notifications@${LOCAL_DOMAIN}"
ask ADMIN_USERNAME '관리자 아이디' 'admin'
ask ADMIN_EMAIL '관리자 이메일 (실제로 받는 메일 주소)'

echo
echo '== 1/4 설정 파일 만들기 =='

cat > "$ENV_FILE" <<EOF
# Generated by bin/docker-setup on $(date -u)
LOCAL_DOMAIN=${LOCAL_DOMAIN}
SINGLE_USER_MODE=false

SECRET_KEY_BASE=$(openssl rand -hex 64)
OTP_SECRET=$(openssl rand -hex 64)
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(openssl rand -hex 16)
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(openssl rand -hex 16)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(openssl rand -hex 16)

DB_HOST=db
DB_PORT=5432
DB_NAME=mastodon_production
DB_USER=postgres
DB_PASS=

REDIS_HOST=redis
REDIS_PORT=6379

SMTP_SERVER=${SMTP_SERVER}
SMTP_PORT=587
SMTP_LOGIN=${SMTP_LOGIN}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_AUTH_METHOD=plain
SMTP_OPENSSL_VERIFY_MODE=peer
SMTP_ENABLE_STARTTLS=auto
SMTP_FROM_ADDRESS=${SMTP_FROM_ADDRESS}

UPDATE_CHECK_URL=
AUTHORIZED_FETCH=true
LIMITED_FEDERATION_MODE=true
DISALLOW_UNAUTHENTICATED_API_ACCESS=true
THROTTLE_API_REQUESTS_PER_PERIOD=3000
THROTTLE_API_PERIOD=300
BOT_THROTTLE_API_REQUESTS_PER_PERIOD=5000
BOT_THROTTLE_API_PERIOD=300
DM_CHAT_ENABLED=true

MA_MULTI_ACCOUNT_REFRESH_FLOW=true
MA_MULTI_ACCOUNT_RETAIN_TOKENS=true
MA_ROLLOUT_PERCENTAGE=100
MA_MULTI_ACCOUNT_REDIRECT_URI=https://${LOCAL_DOMAIN}/multi_accounts/callback
EOF
chmod 600 "$ENV_FILE"

run_web SECRET_KEY_BASE_DUMMY=1 -- bundle exec rails mastodon:webpush:generate_vapid_key | grep '^VAPID_' >> "$ENV_FILE"
echo '설정 파일을 저장했습니다.'

echo
echo '== 2/4 데이터베이스 준비 =='
docker compose up -d db redis
for _ in $(seq 1 30); do
  docker compose exec -T db pg_isready -U postgres >/dev/null 2>&1 && break
  sleep 2
done
run_web -- bin/rails db:create db:schema:load
run_web SAFETY_ASSURED=1 -- bin/rails db:migrate
run_web -- bin/rails db:seed

echo
echo '== 3/4 멀티계정 OAuth 클라이언트 =='
run_web -- bin/rails runner '
  app = Doorkeeper::Application.create!(name: "Web", redirect_uri: ENV.fetch("MA_MULTI_ACCOUNT_REDIRECT_URI"), scopes: "read write follow push")
  puts "MA_MULTI_ACCOUNT_CLIENT_ID=#{app.uid}"
  puts "MA_MULTI_ACCOUNT_CLIENT_SECRET=#{app.plaintext_secret || app.secret}"
' | grep '^MA_MULTI_ACCOUNT_CLIENT_' >> "$ENV_FILE"

echo
echo '== 4/4 관리자 계정 =='
run_web -- bin/tootctl accounts create "$ADMIN_USERNAME" --email "$ADMIN_EMAIL" --confirmed --role Owner
run_web -- bin/tootctl accounts approve "$ADMIN_USERNAME"
run_web ADMIN_USERNAME="$ADMIN_USERNAME" ADMIN_EMAIL="$ADMIN_EMAIL" -- bin/rails runner '
  Setting.site_contact_username = ENV.fetch("ADMIN_USERNAME")
  Setting.site_contact_email = ENV.fetch("ADMIN_EMAIL")
'

echo
echo '설치가 끝났습니다. 위에 나온 관리자 비밀번호(New password)를 꼭 적어두세요.'
echo '서버 시작: docker compose up -d'
