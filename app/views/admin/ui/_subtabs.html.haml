-# 탭 안의 탭 (수업 > 설정·과목들 등). 규칙: docs/관리화면-컴포넌트.md
-#   = render 'admin/ui/subtabs', items: [[이름, 주소, 지금 화면?, 꺼짐?], ...], back: [이름, 주소] (맨 왼쪽 돌아가기, 없어도 됨)
%nav.ui-subtabs{ 'aria-label': local_assigns[:label] }
  - if local_assigns[:back]
    = link_to local_assigns[:back].last, class: 'ui-subtabs__item ui-subtabs__back' do
      %svg{ viewBox: '0 0 24 24', width: 14, height: 14, fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': true }
        %path{ d: 'M5 12l14 0' }
        %path{ d: 'M5 12l6 6' }
        %path{ d: 'M5 12l6 -6' }
      = local_assigns[:back].first
  - items.each do |text, path, active, off|
    = link_to text, path, class: ['ui-subtabs__item', ('ui-subtabs__item--active' if active), ('ui-subtabs__item--off' if off)], 'aria-current': (active ? 'page' : nil)
