-# 아바타 + 이름. 누르면 그 캐릭터의 활동 기록 (명단에 없는 계정이면 이름만)
- name = character&.display_name || account.display_name.presence || account.username
- avatar = image_tag(full_asset_url(account.avatar_static_url), alt: '', class: 'game-table__avatar')
- if character
  = link_to admin_game_activity_logs_path(character: character.account_id), class: 'game-table__name game-records__person' do
    = avatar
    %strong= name
- else
  %span.game-table__name.game-records__person
    = avatar
    %strong= name
