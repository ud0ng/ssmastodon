-# 소속(기숙사·진영) 추가·수정 모달 안의 폼: 이름·테마색·순서
= form_tag url, method: method, class: 'simple_form' do
  - prefix = house.persisted? ? "house_#{house.id}" : "new_house_#{house.category}"
  - if house.new_record?
    = hidden_field_tag 'game_house[category]', house.category, id: nil
  = render 'admin/ui/field', label: game_t('admin.games.houses.name_label'), name: 'game_house[name]', id: "#{prefix}_name", value: house.name, required: true, wide: true
  = render layout: 'admin/ui/fields', locals: { columns: 2 } do
    = render 'admin/ui/field', label: game_t('admin.games.houses.color'), name: 'game_house[color]', id: "#{prefix}_color", value: house.color, type: :color
    = render 'admin/ui/field', label: game_t('admin.games.houses.order'), name: 'game_house[position]', id: "#{prefix}_position", value: house.position, type: :number
  = render 'admin/ui/modal_actions'
