- content_for :page_title do
  = game_t('admin.games.houses.tab')

- content_for :heading do
  = render 'admin/game_characters/heading'

%p.hint= game_t('admin.games.houses.hint', house: @labels['house'], faction: @labels['faction'])

-# 점수 단위: 기숙사 / 진영 중 점수·토너먼트·모래시계·결산에 쓸 쪽
.game-groups__mode
  %span.game-groups__mode-label= game_t('admin.games.houses.mode')
  - GameHouse::CATEGORIES.each do |category|
    = button_to mode_admin_game_houses_path, params: { mode: category }, method: :post, form_class: 'game-groups__mode-form',
                class: ['game-groups__mode-button', ('game-groups__mode-button--active' if @mode == category)], disabled: @mode == category do
      = @labels[category]
      - if @mode == category
        %span.game-groups__mode-on= game_t('admin.games.houses.mode_on')
  %span.hint= game_t('admin.games.houses.mode_hint')

.game-groups
  - GameHouse::CATEGORIES.each do |category|
    - label = @labels[category]
    %section.game-groups__list{ class: ('game-groups__list--active' if @mode == category) }
      %h4
        = label
        - if @mode == category
          %span.game-groups__badge= game_t('admin.games.houses.scoring')
      .game-groups__items
        - @lists[category].each do |house|
          - form_id = "edit_game_house_#{house.id}"
          .game-groups__item{ style: "--house-color: #{house.color.presence || '#6b5b3e'}" }
            = form_tag admin_game_house_path(house), method: :patch, id: form_id, class: 'game-groups__form' do
              = text_field_tag 'game_house[emoji]', house.emoji, id: nil, class: 'game-groups__emoji', size: 3, 'aria-label': game_t('admin.games.houses.emoji')
              = text_field_tag 'game_house[name]', house.name, id: nil, class: 'game-groups__name', 'aria-label': game_t('admin.games.houses.name_label')
              = color_field_tag 'game_house[color]', house.color.presence || '#6b5b3e', id: nil, class: 'game-groups__color', 'aria-label': game_t('admin.games.houses.color')
              = number_field_tag 'game_house[position]', house.position, id: nil, class: 'game-groups__order', 'aria-label': game_t('admin.games.houses.order')
              %span.game-groups__meta
                = game_t('admin.games.houses.members', count: @counts[category].fetch(house.id, 0))
                ·
                %strong= game_t('admin.games.houses.points', count: house.total)
              = button_tag material_symbol('check'), type: :submit, class: 'icon-button', title: t('generic.save_changes')
            = button_to admin_game_house_path(house), method: :delete, class: 'icon-button', form_class: 'game-groups__delete', title: game_t('admin.games.houses.delete_named', name: label),
                        data: { confirm: game_t('admin.games.houses.delete_confirm_named', name: house.name, term: label) } do
              = material_symbol('delete')
        - if @lists[category].empty?
          %p.hint= game_t('admin.games.overview.no_houses')

      = form_tag admin_game_houses_path, method: :post, class: 'game-groups__add' do
        = hidden_field_tag 'game_house[category]', category, id: nil
        = text_field_tag 'game_house[emoji]', '', id: nil, class: 'game-groups__emoji', size: 3, placeholder: '🦁', 'aria-label': game_t('admin.games.houses.emoji')
        = text_field_tag 'game_house[name]', '', id: nil, class: 'game-groups__name', required: true, placeholder: game_t('admin.games.houses.add_named', name: label), 'aria-label': game_t('admin.games.houses.name_label')
        = color_field_tag 'game_house[color]', '#6b5b3e', id: nil, class: 'game-groups__color', 'aria-label': game_t('admin.games.houses.color')
        = button_tag safe_join([material_symbol('add'), game_t('admin.games.houses.add_named', name: label)]), type: :submit, class: 'button button-secondary'

= form_tag adjust_admin_game_houses_path, method: :post, class: 'simple_form bot-sheet-add-row' do
  %h4= game_t('admin.games.houses.adjust')
  %p.hint= game_t('admin.games.houses.adjust_hint')
  .bot-sheet-fields
    .input.with_label
      .label_input
        %label{ for: 'adjust_house' }= game_t('admin.games.houses.name')
        .label_input__wrapper= select_tag :house_id, grouped_options_for_select(GameHouse::CATEGORIES.to_h { |category| [@labels[category], @lists[category].map { |house| [house.label, house.id] }] }), id: 'adjust_house'
    .input.with_label
      .label_input
        %label{ for: 'adjust_amount' }= game_t('admin.games.houses.amount')
        .label_input__wrapper= number_field_tag :amount, nil, id: 'adjust_amount', step: 1, required: true
    .input.with_label.bot-sheet-field--wide
      .label_input
        %label{ for: 'adjust_reason' }= game_t('admin.games.houses.reason')
        .label_input__wrapper= text_field_tag :reason, '', id: 'adjust_reason'
  .actions
    = button_tag game_t('admin.games.houses.adjust'), type: :submit, class: 'button'

- if @recent_points.any?
  %h4.game-houses__recent= game_t('admin.games.houses.recent')
  .bot-sheet-table
    %table.table
      %thead
        %tr
          %th= game_t('admin.games.houses.when')
          %th= game_t('admin.games.houses.name')
          %th= game_t('admin.games.houses.amount')
          %th= game_t('admin.games.houses.reason')
      %tbody
        - @recent_points.each do |point|
          %tr
            %td.bot-sheet-table__text= l(point.created_at.in_time_zone('Asia/Seoul'), format: :short)
            %td.bot-sheet-table__text= point.house.label
            %td.bot-sheet-table__text= format('%+d', point.amount)
            %td.bot-sheet-table__text
              = point.reason
              - if point.account
                = "· @#{point.account.username}"

%h4= game_t('admin.games.houses.announcements')
%p.hint= game_t('admin.games.houses.announcements_hint_html', path: admin_game_setting_path('common'))
.game-houses__announce
  = button_to game_t('admin.games.houses.weekly_now'), weekly_admin_game_houses_path, method: :post, class: 'button button-secondary', data: { confirm: game_t('admin.games.houses.weekly_confirm') }
  = button_to game_t('admin.games.houses.term_end'), term_end_admin_game_houses_path, method: :post, class: 'button', data: { confirm: game_t('admin.games.houses.term_end_confirm') }
