- content_for :page_title do
  = game_t('admin.games.houses.tab')

- content_for :heading do
  = render 'admin/game_characters/heading'

-# 점수 기준 소속: 기숙사 / 진영 중 점수를 모을 쪽
- add_any = button_tag safe_join([material_symbol('add'), game_t('admin.games.houses.add_any')]), type: :button, class: 'button', data: { modal_open: 'house-add-any' }
- rename = button_tag safe_join([material_symbol('edit'), game_t('admin.games.houses.rename')]), type: :button, class: 'button button-tertiary', data: { modal_open: 'house-labels' }
= render layout: 'admin/ui/section', locals: { title: game_t('admin.games.houses.mode'), hint: game_t('admin.games.houses.mode_hint'), actions: safe_join([add_any, rename]) } do
  = render 'admin/ui/segmented', url: mode_admin_game_houses_path, param: :mode, value: @mode, label: game_t('admin.games.houses.mode'),
                                 options: GameHouse::CATEGORIES.map { |category| [@labels[category], category] }

-# 소속 추가: 종류(기숙사·진영)를 고르고 이름·색·순서를 정한다
= render layout: 'admin/ui/modal', locals: { id: 'house-add-any', title: game_t('admin.games.houses.add_any') } do
  = form_tag admin_game_houses_path, method: :post, class: 'simple_form' do
    = render 'admin/ui/field', label: game_t('admin.games.houses.kind'), name: 'game_house[category]', id: 'house_add_any_category', value: GameHouse::CATEGORIES.first, type: :select,
                               options: GameHouse::CATEGORIES.map { |category| [@labels[category], category] }, wide: true
    = render 'admin/ui/field', label: game_t('admin.games.houses.name_label'), name: 'game_house[name]', id: 'house_add_any_name', value: '', required: true, wide: true
    = render layout: 'admin/ui/fields', locals: { columns: 2 } do
      = render 'admin/ui/field', label: game_t('admin.games.houses.color'), name: 'game_house[color]', id: 'house_add_any_color', value: '#6b5b3e', type: :color
      = render 'admin/ui/field', label: game_t('admin.games.houses.order'), name: 'game_house[position]', id: 'house_add_any_position', value: GameHouse.count, type: :number
    = render 'admin/ui/modal_actions'

= render layout: 'admin/ui/modal', locals: { id: 'house-labels', title: game_t('admin.games.houses.rename') } do
  = form_tag labels_admin_game_houses_path, method: :patch, class: 'simple_form' do
    = render layout: 'admin/ui/fields', locals: { columns: 2 } do
      - GameHouse::CATEGORIES.each do |category|
        = render 'admin/ui/field', label: game_t("admin.games.houses.label_#{category}"), name: "labels[#{category}]", id: "house_label_#{category}", value: @labels[category], required: true, html: { maxlength: 20 }
    = render 'admin/ui/modal_actions'

= render 'admin/game_houses/seasons'

-# 기숙사 · 진영 목록
- GameHouse::CATEGORIES.each do |category|
  - label = @labels[category]
  - actions = capture do
    = button_tag safe_join([material_symbol('add'), game_t('admin.games.houses.add_named', name: label)]), type: :button, class: 'button', data: { modal_open: "house-add-#{category}" }
    - if category == GameHouse::CATEGORIES.first
      = button_tag safe_join([material_symbol('edit_note'), game_t('admin.games.houses.adjust')]), type: :button, class: 'button button-secondary', data: { modal_open: 'house-adjust' }
  - title = capture do
    = label
    - if @mode == category
      %span.game-houses__badge= game_t('admin.games.houses.scoring')
  = render layout: 'admin/ui/section', locals: { title: title, actions: actions } do
    .bot-sheet-table.game-table
      %table.table
        %thead
          %tr
            %th= game_t('admin.games.houses.name_label')
            %th= game_t('admin.games.houses.color')
            %th= game_t('admin.games.houses.order')
            %th= game_t('admin.games.houses.members_head')
            %th= game_t('admin.games.houses.points_head')
            %th= game_t('admin.games.fx.card_effects')
            %th.bot-sheet-table__actions
        %tbody
          - @lists[category].each do |house|
            %tr
              %td.bot-sheet-table__text
                .game-houses__name
                  %span.game-swatch{ style: "--swatch: #{house.color.presence || '#6b5b3e'}" }
                  %strong= house.name
              %td.bot-sheet-table__text= house.color.presence || '—'
              %td.bot-sheet-table__text= house.position
              %td.bot-sheet-table__text= @counts[category].fetch(house.id, 0)
              %td.bot-sheet-table__text= house.total
              %td.bot-sheet-table__text= game_fx_badges(house, 'card')
              %td.bot-sheet-table__actions
                = button_tag material_symbol('celebration'), type: :button, class: 'icon-button', title: game_t('admin.games.fx.card_effects'), data: { modal_open: "house-fx-#{house.id}" }
                = button_tag material_symbol('edit'), type: :button, class: 'icon-button', title: game_t('admin.games.houses.edit'), data: { modal_open: "house-#{house.id}" }
                = button_to admin_game_house_path(house), method: :delete, class: 'icon-button', form_class: 'bot-sheet-table__delete', title: game_t('admin.games.houses.delete_named', name: label),
                            data: { confirm: game_t('admin.games.houses.delete_confirm_named', name: house.name, term: label) } do
                  = material_symbol('delete')
          - if @lists[category].empty?
            %tr
              %td.bot-sheet-table__text{ colspan: 7 }= game_t('admin.games.overview.no_houses')

  = render layout: 'admin/ui/modal', locals: { id: "house-add-#{category}", title: game_t('admin.games.houses.add_named', name: label) } do
    = render 'admin/game_houses/form', house: GameHouse.new(category: category, color: '#6b5b3e', position: @lists[category].size), url: admin_game_houses_path, method: :post

  -# 붙은 카드 효과: 미리보기·이름·남은 시간(고치기)·지우기
  - effects_by_id = GameEffect.unscoped.index_by(&:id)
  - @lists[category].each do |house|
    = render layout: 'admin/ui/modal', locals: { id: "house-fx-#{house.id}", title: "#{house.name} #{game_t('admin.games.fx.card_effects')}" } do
      - house.fx_entries.each do |index, entry|
        = render 'admin/game_effects/entry', effect: effects_by_id[entry['effect_id'].to_i], entry: entry, id: "house_#{house.id}_fx_#{index}",
                                             update_url: effect_admin_game_house_path(house, index), delete_url: effect_admin_game_house_path(house, index)
      - if house.fx_entries.empty?
        %p.hint= game_t('admin.games.fx.no_entries')
      = render 'admin/game_effects/add_form', url: add_effect_admin_game_house_path(house), kind: 'house', id: "house_#{house.id}_fx"

  - @lists[category].each do |house|
    = render layout: 'admin/ui/modal', locals: { id: "house-#{house.id}", title: game_t('admin.games.houses.edit') } do
      = render 'admin/game_houses/form', house: house, url: admin_game_house_path(house), method: :patch

= render layout: 'admin/ui/modal', locals: { id: 'house-adjust', title: game_t('admin.games.houses.adjust') } do
  = form_tag adjust_admin_game_houses_path, method: :post, class: 'simple_form' do
    %p.hint= game_t('admin.games.houses.adjust_hint')
    = render layout: 'admin/ui/fields', locals: { columns: 2 } do
      = render layout: 'admin/ui/field', locals: { label: game_t('admin.games.houses.name'), id: 'adjust_house', type: :custom } do
        = select_tag :house_id, grouped_options_for_select(GameHouse::CATEGORIES.to_h { |category| [@labels[category], @lists[category].map { |house| [house.label, house.id] }] }), id: 'adjust_house', class: 'ui-input ui-input--select'
      = render 'admin/ui/field', label: game_t('admin.games.houses.amount'), name: 'amount', id: 'adjust_amount', type: :number, required: true
    = render 'admin/ui/field', label: game_t('admin.games.houses.reason'), name: 'reason', id: 'adjust_reason', wide: true
    = render 'admin/ui/modal_actions', submit: game_t('admin.games.houses.adjust')
