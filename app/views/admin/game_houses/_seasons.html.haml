-# 시즌: 점수 방식(점수제/판수제), 시즌 목록(진행 중이면 중간 결산·시즌 종료), 시즌 문구
- running = @seasons.find(&:running?)
- add = button_tag safe_join([material_symbol('add'), game_t('admin.games.seasons.add')]), type: :button, class: 'button', disabled: running.present?, title: (game_t('admin.games.seasons.already_running') if running), data: { modal_open: 'season-add' }
= render layout: 'admin/ui/section', locals: { title: game_t('admin.games.seasons.title'), actions: add } do
  .ui-field
    .label_input
      %label= game_t('admin.games.seasons.scoring')
      = render 'admin/ui/segmented', url: scoring_admin_game_houses_path, param: :scoring_mode, value: @scoring_mode, label: game_t('admin.games.seasons.scoring'),
                                     options: [[game_t('admin.games.seasons.scoring_points'), 'points'], [game_t('admin.games.seasons.scoring_games'), 'games']]
    %span.hint= game_t('admin.games.seasons.scoring_hint')

  .bot-sheet-table.game-table
    %table.table
      %thead
        %tr
          %th= game_t('admin.games.seasons.name')
          %th= game_t('admin.games.seasons.period')
          %th= game_t('admin.games.seasons.status')
          %th= game_t('admin.games.seasons.result')
          %th.bot-sheet-table__actions
      %tbody
        - @seasons.each do |season|
          %tr
            %td.bot-sheet-table__text
              %strong= season.name
            %td.bot-sheet-table__text= season.period.presence || '—'
            %td.bot-sheet-table__text
              %span.game-badge{ class: "game-badge--season-#{season.display_status}" }= game_t("admin.games.seasons.statuses.#{season.display_status}")
            %td.bot-sheet-table__text
              - if season.running? && !season.upcoming?
                = Game::Points.ranking.map { |house, total| "#{house.name} #{total}" }.join(' · ').presence || '—'
              - else
                = Array(season.results).map { |row| "#{row['name']} #{row['total']}" }.join(' · ').presence || '—'
            %td.bot-sheet-table__actions
              - if season.running? && !season.upcoming?
                = button_to game_t('admin.games.seasons.interim'), interim_admin_game_season_path(season), method: :post, class: 'button button-secondary game-season__action', form_class: 'bot-sheet-table__delete', data: { confirm: game_t('admin.games.seasons.interim_confirm') }
                = button_to game_t('admin.games.seasons.finish'), finish_admin_game_season_path(season), method: :post, class: 'button game-season__action', form_class: 'bot-sheet-table__delete', data: { confirm: game_t('admin.games.seasons.finish_confirm', name: season.name) }
              = button_tag material_symbol('edit'), type: :button, class: 'icon-button', title: game_t('admin.games.seasons.edit'), data: { modal_open: "season-#{season.id}" }
              = button_to admin_game_season_path(season), method: :delete, class: 'icon-button', form_class: 'bot-sheet-table__delete', title: game_t('admin.games.seasons.delete'), data: { confirm: game_t('admin.games.seasons.delete_confirm', name: season.name) } do
                = material_symbol('delete')
        - if @seasons.empty?
          %tr
            %td.bot-sheet-table__text{ colspan: 5 }= game_t('admin.games.seasons.empty')

-# 시즌 문구
= render layout: 'admin/ui/section', locals: { title: game_t('admin.games.seasons.messages'), hint: game_t('admin.games.seasons.messages_hint') } do
  = form_tag messages_admin_game_seasons_path, method: :patch, class: 'simple_form' do
    - @season_fields.each do |field|
      = render 'admin/ui/field', label: field.label, name: "config[#{field.key}]", id: "season_#{field.key}", value: @season_values[field.key], type: :textarea,
                                 html: { rows: [@season_values[field.key].to_s.lines.size + 1, 3].max }
    .actions
      = button_tag t('generic.save_changes'), type: :submit, class: 'button'

- ([GameSeason.new] + @seasons).each do |season|
  - id = season.persisted? ? "season-#{season.id}" : 'season-add'
  = render layout: 'admin/ui/modal', locals: { id: id, title: game_t(season.persisted? ? 'admin.games.seasons.edit' : 'admin.games.seasons.add') } do
    = form_tag (season.persisted? ? admin_game_season_path(season) : admin_game_seasons_path), method: (season.persisted? ? :patch : :post), class: 'simple_form' do
      = render 'admin/ui/field', label: game_t('admin.games.seasons.name'), name: 'game_season[name]', id: "#{id}-name", value: season.name, required: true, wide: true,
                                 placeholder: game_t('admin.games.seasons.name_placeholder'), html: { maxlength: 50 }
      = render layout: 'admin/ui/fields', locals: { columns: 2 } do
        = render 'admin/ui/field', label: game_t('admin.games.seasons.starts_on'), name: 'game_season[starts_on]', id: "#{id}-starts", value: season.starts_on, type: :date
        = render 'admin/ui/field', label: game_t('admin.games.seasons.ends_on'), name: 'game_season[ends_on]', id: "#{id}-ends", value: season.ends_on, type: :date
      = render 'admin/ui/modal_actions'
