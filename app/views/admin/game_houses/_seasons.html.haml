-# 시즌: 점수 방식, 시즌 목록(진행 중이면 중간 결산·시즌 종료), 시즌 문구
- running = @seasons.find(&:running?)
.game-toolbar.game-houses__title
  %h4= game_t('admin.games.seasons.title')
  = button_tag safe_join([material_symbol('add'), game_t('admin.games.seasons.add')]), type: :button, class: 'button', disabled: running.present?, title: (game_t('admin.games.seasons.already_running') if running), data: { modal_open: 'season-add' }

.game-season__settings
  = form_tag scoring_admin_game_houses_path, method: :post, class: 'simple_form game-season__scoring' do
    .input.with_label.select
      .label_input
        %label{ for: 'season_scoring_mode' }= game_t('admin.games.seasons.scoring')
        .label_input__wrapper
          = select_tag :scoring_mode, options_for_select([[game_t('admin.games.seasons.scoring_points'), 'points'], [game_t('admin.games.seasons.scoring_games'), 'games']], @scoring_mode), id: 'season_scoring_mode', onchange: 'this.form.requestSubmit()'
      %span.hint= game_t('admin.games.seasons.scoring_hint')

.bot-sheet-table.game-table
  %table.table
    %thead
      %tr
        %th= game_t('admin.games.seasons.name')
        %th= game_t('admin.games.seasons.period')
        %th= game_t('admin.games.seasons.status')
        %th= game_t('admin.games.seasons.result')
        %th.bot-sheet-table__actions
    %tbody
      - @seasons.each do |season|
        %tr
          %td.bot-sheet-table__text
            %strong= season.name
          %td.bot-sheet-table__text= season.period.presence || '—'
          %td.bot-sheet-table__text
            %span.game-badge{ class: (season.running? ? 'game-badge--tournament-running' : 'game-badge--tournament-finished') }= game_t("admin.games.seasons.statuses.#{season.status}")
          %td.bot-sheet-table__text
            - if season.running?
              = Game::Points.ranking.map { |house, total| "#{house.name} #{total}" }.join(' · ').presence || '—'
            - else
              = Array(season.results).map { |row| "#{row['name']} #{row['total']}" }.join(' · ').presence || '—'
          %td.bot-sheet-table__actions
            - if season.running?
              = button_to game_t('admin.games.seasons.interim'), interim_admin_game_season_path(season), method: :post, class: 'button button-secondary game-season__action', form_class: 'bot-sheet-table__delete', data: { confirm: game_t('admin.games.seasons.interim_confirm') }
              = button_to game_t('admin.games.seasons.finish'), finish_admin_game_season_path(season), method: :post, class: 'button game-season__action', form_class: 'bot-sheet-table__delete', data: { confirm: game_t('admin.games.seasons.finish_confirm', name: season.name) }
            = button_tag material_symbol('edit'), type: :button, class: 'icon-button', title: game_t('admin.games.seasons.edit'), data: { modal_open: "season-#{season.id}" }
            = button_to admin_game_season_path(season), method: :delete, class: 'icon-button', form_class: 'bot-sheet-table__delete', title: game_t('admin.games.seasons.delete'), data: { confirm: game_t('admin.games.seasons.delete_confirm', name: season.name) } do
              = material_symbol('delete')
      - if @seasons.empty?
        %tr
          %td.bot-sheet-table__text{ colspan: 5 }= game_t('admin.games.seasons.empty')

-# 시즌 문구
%details.game-season__messages
  %summary= game_t('admin.games.seasons.messages')
  = form_tag messages_admin_game_seasons_path, method: :patch, class: 'simple_form' do
    %p.hint= game_t('admin.games.seasons.messages_hint')
    - @season_fields.each do |field|
      .input.with_label.text
        .label_input
          %label{ for: "season_#{field.key}" }= field.label
          .label_input__wrapper= text_area_tag "config[#{field.key}]", @season_values[field.key], id: "season_#{field.key}", rows: [@season_values[field.key].to_s.lines.size + 1, 3].max
    .actions
      = button_tag t('generic.save_changes'), type: :submit, class: 'button'

- ([GameSeason.new] + @seasons).each do |season|
  - id = season.persisted? ? "season-#{season.id}" : 'season-add'
  = render layout: 'admin/game_characters/modal', locals: { id: id, title: game_t(season.persisted? ? 'admin.games.seasons.edit' : 'admin.games.seasons.add') } do
    = form_tag (season.persisted? ? admin_game_season_path(season) : admin_game_seasons_path), method: (season.persisted? ? :patch : :post), class: 'simple_form' do
      .input.with_label.string.required
        .label_input
          %label{ for: "#{id}-name" }= game_t('admin.games.seasons.name')
          .label_input__wrapper= text_field_tag 'game_season[name]', season.name, id: "#{id}-name", required: true, maxlength: 50, placeholder: game_t('admin.games.seasons.name_placeholder')
      .bot-sheet-fields
        .input.with_label
          .label_input
            %label{ for: "#{id}-starts" }= game_t('admin.games.seasons.starts_on')
            .label_input__wrapper= date_field_tag 'game_season[starts_on]', season.starts_on, id: "#{id}-starts"
        .input.with_label
          .label_input
            %label{ for: "#{id}-ends" }= game_t('admin.games.seasons.ends_on')
            .label_input__wrapper= date_field_tag 'game_season[ends_on]', season.ends_on, id: "#{id}-ends"
      .actions
        %button.button.button-tertiary{ type: 'button', data: { modal_close: true } }= t('generic.cancel')
        = button_tag t('generic.save_changes'), type: :submit, class: 'button'
