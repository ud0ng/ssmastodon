- content_for :page_title do
  = game_t('admin.games.characters.fields.title')

- content_for :heading do
  = render 'admin/game_characters/heading'

%p.hint= game_t('admin.games.characters.fields.hint', currency: @currency)

- kinds = GameCharacterField::KINDS.map { |kind| [game_t("admin.games.characters.fields.kinds.#{kind}"), kind] }
- sections = GameCharacterField::SECTIONS.map { |section| [game_t("admin.games.characters.fields.sections.#{section}"), section] }
- choices_editor = { columns: [game_t('admin.games.characters.fields.choice_name'), game_t('admin.games.characters.fields.choice_color')], sep: '|' }.to_json

.game-fields
  - @fields.each do |field|
    .game-fields__card
      = simple_form_for field, url: admin_game_character_field_path(field), method: :patch do |f|
        .game-fields__head
          %span.game-fields__badge= game_t("admin.games.characters.fields.sections.#{field.section}")
          %strong= field.name
          %span.game-fields__kind= game_t("admin.games.characters.fields.kinds.#{field.kind}")
        .bot-sheet-fields
          = f.input :name, wrapper: :with_label, label: game_t('admin.games.characters.fields.name')
          = f.input :kind, as: :select, collection: kinds, include_blank: false, wrapper: :with_label, label: game_t('admin.games.characters.fields.kind')
          = f.input :section, as: :select, collection: sections, include_blank: false, wrapper: :with_label, label: game_t('admin.games.characters.fields.section')
          = f.input :position, as: :integer, wrapper: :with_label, label: game_t('admin.games.houses.order')
        - if field.select?
          = f.input :choices_text, as: :text, wrapper: :with_label, label: game_t('admin.games.characters.fields.choices'), hint: game_t('admin.games.characters.fields.choices_hint'), input_html: { rows: 3, data: { stats_editor: choices_editor } }
        .game-fields__actions
          = button_tag safe_join([material_symbol('check'), t('generic.save_changes')]), type: :submit, class: 'button button-secondary'
      = button_to admin_game_character_field_path(field), method: :delete, class: 'icon-button', form_class: 'game-fields__delete', title: game_t('admin.games.characters.fields.delete'), data: { confirm: game_t('admin.games.characters.fields.delete_confirm', name: field.name) } do
        = material_symbol('delete')

= simple_form_for GameCharacterField.new, url: admin_game_character_fields_path, method: :post, html: { class: 'bot-sheet-add-row' } do |f|
  %h4= game_t('admin.games.characters.fields.add')
  .bot-sheet-fields
    = f.input :name, wrapper: :with_label, label: game_t('admin.games.characters.fields.name'), required: true, input_html: { placeholder: game_t('admin.games.characters.fields.name_placeholder') }
    = f.input :kind, as: :select, collection: kinds, include_blank: false, wrapper: :with_label, label: game_t('admin.games.characters.fields.kind')
    = f.input :section, as: :select, collection: sections, include_blank: false, wrapper: :with_label, label: game_t('admin.games.characters.fields.section')
  = f.input :choices_text, as: :text, wrapper: :with_label, label: game_t('admin.games.characters.fields.choices'), hint: game_t('admin.games.characters.fields.choices_new_hint'), input_html: { rows: 3, data: { stats_editor: choices_editor } }
  .actions
    = button_tag safe_join([material_symbol('add'), game_t('admin.games.characters.fields.add')]), type: :submit, class: 'button'
