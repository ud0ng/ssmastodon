- content_for :page_title do
  = game_t('admin.games.manage.tabs.fields')

- content_for :heading do
  = render 'admin/game_characters/heading'

.game-toolbar
  %p.hint= game_t('admin.games.manage.fields.hint')
  = button_tag safe_join([material_symbol('add'), game_t('admin.games.manage.fields.add')]), type: :button, class: 'button', data: { modal_open: 'field-add' }

.bot-sheet-table.game-table
  %table.table
    %thead
      %tr
        %th= game_t('admin.games.manage.fields.name')
        %th= game_t('admin.games.manage.fields.kind')
        %th= game_t('admin.games.manage.fields.options')
        %th= game_t('admin.games.manage.fields.description')
        %th.bot-sheet-table__actions
    %tbody
      - @fields.each do |field|
        %tr
          %td.bot-sheet-table__text
            %strong= field.name
          %td.bot-sheet-table__text= game_t("admin.games.manage.fields.kinds.#{field.select? ? 'select' : 'text'}")
          %td.bot-sheet-table__text
            - if field.select?
              - Array(field.choices).each do |choice|
                %span.game-badge{ style: (choice['color'].present? ? "--badge: #{choice['color']}" : nil) }= choice['name']
            - else
              \—
          %td.bot-sheet-table__text= field.description.presence || '—'
          %td.bot-sheet-table__actions
            = button_tag material_symbol('edit'), type: :button, class: 'icon-button', title: game_t('admin.games.manage.fields.edit'), data: { modal_open: "field-#{field.id}" }
            = button_to admin_game_character_field_path(field), method: :delete, class: 'icon-button', form_class: 'bot-sheet-table__delete', title: game_t('admin.games.manage.fields.delete'), data: { confirm: game_t('admin.games.manage.fields.delete_confirm', name: field.name) } do
              = material_symbol('delete')
      - if @fields.empty?
        %tr
          %td.bot-sheet-table__text{ colspan: 5 }= game_t('admin.games.manage.fields.empty')

= render layout: 'admin/game_characters/modal', locals: { id: 'field-add', title: game_t('admin.games.manage.fields.add') } do
  = render 'admin/game_character_fields/form', field: GameCharacterField.new(kind: 'text'), url: admin_game_character_fields_path, method: :post

- @fields.each do |field|
  = render layout: 'admin/game_characters/modal', locals: { id: "field-#{field.id}", title: game_t('admin.games.manage.fields.edit') } do
    = render 'admin/game_character_fields/form', field: field, url: admin_game_character_field_path(field), method: :patch
