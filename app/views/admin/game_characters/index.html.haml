- content_for :page_title do
  = game_t('admin.games.manage.title')

- content_for :heading do
  = render 'admin/game_characters/heading'

- none = game_t('admin.games.manage.none')
- column_count = 8 + @base_stats.size + @statuses.size

-# 찾기 + 소속·진영 거르기 (서버원 관리와 같은 모양)
= form_tag admin_game_characters_path, method: :get, class: 'simple_form game-table__filter' do
  .filters
    .filter-subset.filter-subset--with-select
      %strong= @labels['house_label']
      .input.select.optional
        = select_tag :house, options_for_select([[game_t('admin.games.manage.roster.all'), ''], [none, 'none']] + @houses.map { |house| [house.name, house.id] }, params[:house])
    .filter-subset.filter-subset--with-select
      %strong= @labels['faction_label']
      .input.select.optional
        = select_tag :faction, options_for_select([[game_t('admin.games.manage.roster.all'), ''], [none, 'none']] + @factions.map { |faction| [faction.name, faction.id] }, params[:faction])
  .fields-group
    .input.string.optional
      = text_field_tag :q, params[:q], class: 'string optional', placeholder: game_t('admin.games.manage.roster.search')
  .actions
    = button_tag game_t('admin.games.manage.roster.apply'), type: :submit, class: 'button'

= form_tag bulk_admin_game_characters_path, method: :patch, class: 'simple_form game-roster' do
  - filter_params.each do |key, value|
    = hidden_field_tag key, value, id: nil

  .bot-sheet-table.game-table.game-table--scroll
    %table.table
      %thead
        %tr
          %th.game-table__check= check_box_tag :select_all, '1', false, data: { select_all: 'ids[]' }, 'aria-label': game_t('admin.games.characters.select_all')
          %th= game_t('admin.games.manage.roster.name')
          %th= game_t('admin.games.manage.roster.acct')
          %th= @labels['house_label']
          %th= @labels['faction_label']
          %th= game_t('admin.games.manage.roster.grade')
          - @base_stats.each do |stat|
            %th= stat.name
          - @statuses.each do |status|
            %th= status.name
          %th= game_t('admin.games.manage.roster.money', currency: @currency)
          %th.bot-sheet-table__actions
      %tbody
        - if @characters.empty?
          %tr
            %td.bot-sheet-table__text{ colspan: column_count }= game_t('admin.games.manage.roster.empty')
        - groups = (GameHouse.active.to_a + [nil]).filter_map { |group| [group, @characters.select { |character| character.group == group }] if @characters.any? { |character| character.group == group } }
        - groups.each do |group, members|
          %tr.game-table__group
            %td{ colspan: column_count }
              %span.game-swatch{ style: "--swatch: #{group&.color.presence || '#8b8b8b'}" }
              %strong= group&.name || game_t('admin.games.manage.roster.no_group', term: @labels[GameHouse.mode == 'faction' ? 'faction_label' : 'house_label'])
              %span.game-table__count= game_t('admin.games.manage.roster.count', count: members.size)
          - members.each do |character|
            - stat_values = @base_stats.to_h { |stat| [stat.name, character.stat_value(stat)] }
            %tr.game-table__row{ data: { href: edit_admin_game_character_path(character, filter_params) } }
              %td.game-table__check= check_box_tag 'ids[]', character.id, false, id: "character_#{character.id}", 'aria-label': character.display_name
              %td.bot-sheet-table__text
                = link_to edit_admin_game_character_path(character, filter_params), class: 'game-table__name' do
                  = image_tag full_asset_url(character.account.avatar_static_url), alt: '', class: 'game-table__avatar'
                  %strong= character.display_name
              %td.bot-sheet-table__text= link_to "@#{character.account.username}", admin_account_path(character.account_id)
              %td.bot-sheet-table__text= character.house&.name || none
              %td.bot-sheet-table__text= character.faction&.name || none
              %td.bot-sheet-table__text= character.grade ? game_t('admin.games.characters.grade_value', grade: character.grade) : none
              - @base_stats.each do |stat|
                %td.bot-sheet-table__text= stat_values[stat.name]
              - @statuses.each do |status|
                %td.bot-sheet-table__text= character.status_value(status, @base_stats) || '-'
              %td.bot-sheet-table__text= number_with_delimiter(character.money)
              %td.bot-sheet-table__actions
                = link_to material_symbol('edit'), edit_admin_game_character_path(character, filter_params), class: 'icon-button', title: game_t('admin.games.characters.edit')

  -# 고른 캐릭터의 기숙사·진영을 한꺼번에 바꾸기
  .game-roster__bulk
    - targets = { @labels['house_label'] => @houses.map { |house| [house.name, "house:#{house.id}"] } + [["#{@labels['house_label']}: #{none}", 'house:none']] }
    - targets[@labels['faction_label']] = @factions.map { |faction| [faction.name, "faction:#{faction.id}"] } + [["#{@labels['faction_label']}: #{none}", 'faction:none']]
    .input.select.optional
      = select_tag :target, grouped_options_for_select(targets), 'aria-label': game_t('admin.games.characters.bulk_target')
    = button_tag game_t('admin.games.characters.bulk_apply'), type: :submit, class: 'button'

= paginate @characters
