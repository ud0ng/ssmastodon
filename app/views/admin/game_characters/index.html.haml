- content_for :page_title do
  = game_t('admin.games.manage.title')

- content_for :heading do
  = render 'admin/game_characters/heading'

- none = game_t('admin.games.manage.none')
- column_count = 4 + @extra_kinds.size + @counter_groups.size + @base_stats.size + @statuses.size

-# 찾기 + 소속·진영 거르기 (서버원 관리와 같은 모양)
= form_tag admin_game_characters_path, method: :get, class: 'simple_form game-table__filter' do
  .filters
    .filter-subset.filter-subset--with-select
      %strong= @labels['house_label']
      .input.select.optional
        = select_tag :house, options_for_select([[game_t('admin.games.manage.roster.all'), ''], [none, 'none']] + @houses.map { |house| [house.name, house.id] }, params[:house])
    .filter-subset.filter-subset--with-select
      %strong= @labels['faction_label']
      .input.select.optional
        = select_tag :faction, options_for_select([[game_t('admin.games.manage.roster.all'), ''], [none, 'none']] + @factions.map { |faction| [faction.name, faction.id] }, params[:faction])
    - @extra_kinds.each do |kind, houses|
      .filter-subset.filter-subset--with-select
        %strong= kind['label']
        .input.select.optional
          = select_tag "groups[#{kind['key']}]", options_for_select([[game_t('admin.games.manage.roster.all'), ''], [none, 'none']] + houses.map { |house| [house.name, house.id] }, params.dig(:groups, kind['key'])), id: "groups_#{kind['key']}"
  -# 거를 때도 고른 정렬은 그대로
  = hidden_field_tag :sort, params[:sort] if params[:sort].present?
  = hidden_field_tag :dir, params[:dir] if params[:dir].present?
  .fields-group
    .input.string.optional
      = text_field_tag :q, params[:q], class: 'string optional', placeholder: game_t('admin.games.manage.roster.search')
  .actions
    = button_tag game_t('admin.games.manage.roster.apply'), type: :submit, class: 'button'

.bot-sheet-table.game-table.game-table--scroll
  %table.table
    %thead
      -# 머리 칸을 누르면 정렬 (활동 탭 표와 같은 game_sort_header): 같은 칸을 다시 누르면 오름차순 ↔ 내림차순
      - sort_key, sort_dir = roster_sort
      %tr
        %th= game_sort_header(game_t('admin.games.manage.roster.name'), 'name', sort_key, sort_dir)
        %th= game_sort_header(@labels['house_label'], 'house', sort_key, sort_dir)
        %th= game_sort_header(@labels['faction_label'], 'faction', sort_key, sort_dir)
        - @extra_kinds.each do |kind, _|
          %th= game_sort_header(kind['label'], "group:#{kind['key']}", sort_key, sort_dir)
        %th= game_sort_header(@currency, 'money', sort_key, sort_dir)
        -# 누적 수치: 상성이 있으면 '벌점/상점' 처럼 함께 (값은 상쇄하고 난 현재값, 정렬은 앞의 수치로)
        - @counter_groups.each do |group|
          %th= game_sort_header(group.compact.map(&:name).join('/'), "counter:#{group.compact.first.id}", sort_key, sort_dir)
        - @base_stats.each do |stat|
          %th= game_sort_header(stat.name, "stat:#{stat.id}", sort_key, sort_dir)
        - @statuses.each do |status|
          %th= game_sort_header(status.name, "status:#{status.id}", sort_key, sort_dir)
    %tbody
      - if @characters.empty?
        %tr
          %td.bot-sheet-table__text{ colspan: column_count }= game_t('admin.games.manage.roster.empty')
      - @characters.each do |character|
        - stat_values = @base_stats.to_h { |stat| [stat.name, character.stat_value(stat)] }
        %tr.game-table__row{ data: { href: edit_admin_game_character_path(character, filter_params) } }
          = render 'admin/game_characters/name_cell', character: character, path: edit_admin_game_character_path(character, filter_params)
          -# 소속·진영: 누르면 바로 드롭다운, 고르면 그 자리에서 저장 (admin/inline_select.ts)
          %td.bot-sheet-table__text
            = select_tag "house_#{character.id}", options_for_select([[none, '']] + @houses.map { |house| [house.name, house.id] }, character.game_house_id), class: 'game-inline-select', 'aria-label': @labels['house_label'], data: { inline_save: group_admin_game_character_path(character), kind: 'house' }
          %td.bot-sheet-table__text
            = select_tag "faction_#{character.id}", options_for_select([[none, '']] + @factions.map { |faction| [faction.name, faction.id] }, character.game_faction_id), class: 'game-inline-select', 'aria-label': @labels['faction_label'], data: { inline_save: group_admin_game_character_path(character), kind: 'faction' }
          - @extra_kinds.each do |kind, houses|
            %td.bot-sheet-table__text
              = select_tag "group_#{kind['key']}_#{character.id}", options_for_select([[none, '']] + houses.map { |house| [house.name, house.id] }, character.extra_group_ids[kind['key']]), class: 'game-inline-select', 'aria-label': kind['label'], data: { inline_save: group_admin_game_character_path(character), kind: kind['key'] }
          %td.bot-sheet-table__text= number_with_delimiter(character.money)
          - @counter_groups.each do |group|
            %td.bot-sheet-table__text= group.compact.map { |counter| counter.net_for(character) }.join('/')
          - @base_stats.each do |stat|
            %td.bot-sheet-table__text= stat_values[stat.name]
          - @statuses.each do |status|
            %td.bot-sheet-table__text= character.status_value(status, @base_stats) || '-'


= paginate @characters
