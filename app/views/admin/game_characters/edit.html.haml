- content_for :page_title do
  = game_t('admin.games.characters.edit_title', name: @character.display_name)

- content_for :heading do
  = render 'admin/game_characters/heading'

- account = @character.account
- win, lose, draw = @record['win'].to_i, @record['lose'].to_i, @record['draw'].to_i

-# 구글 느낌의 심플한 상세 화면: 흰 카드·옅은 테두리·파란 포인트. 머리(아바타 | 이름 (아이디) | 소속 배지 한 줄 + 전적) → 기본 정보 → 스탯(정의된 경우만)
.gd
  .gd-hero
    = image_tag full_asset_url(account.avatar_static_url), alt: '', class: 'gd-hero__avatar'
    .gd-hero__main
      .gd-hero__line
        %h1.gd-hero__name= @character.display_name
        = link_to "(@#{account.username})", admin_account_path(account.id), class: 'gd-hero__acct'
        - [@character.house, @character.faction].compact.each do |group|
          %span.gd-chip{ style: "--badge: #{group.color.presence || '#6b5b3e'}" }= group.name
    .gd-hero__record
      %span.gd-record
        %strong.gd-record__win= win
        %small= game_t('admin.games.manage.detail.results.win')
      %span.gd-record
        %strong.gd-record__lose= lose
        %small= game_t('admin.games.manage.detail.results.lose')
      %span.gd-record
        %strong= draw
        %small= game_t('admin.games.manage.detail.results.draw')
      = link_to game_t('admin.games.records.view_record'), admin_game_records_path(character: @character.account_id), class: 'gd-link'
      -# 누적 수치: 상성이 있으면 '벌점/상점' 처럼 함께, 값은 상쇄하고 난 현재값
      - seen = []
      - @counters.each do |counter|
        - next if seen.include?(counter.id)

        - seen << counter.id
        - pair = counter.opposite
        - seen << pair.id if pair
        %span.gd-record.gd-record--counter
          %strong= [counter, pair].compact.map { |each| each.net_for(@character) }.join('/')
          %small= [counter, pair].compact.map(&:name).join('/')

  = simple_form_for @character, url: admin_game_character_path(@character, filter_params), method: :patch, html: { class: 'gd-form' } do |f|
    = render 'shared/error_messages', object: @character

    - stats_defined = @base_stats.any? || @statuses.any?

    %section.gd-card
      %h2.gd-card__title= game_t('admin.games.manage.detail.profile')
      = render 'admin/ui/field', label: game_t('admin.games.characters.name'), name: 'game_character[name]', id: 'game_character_name', value: @character.name, wide: true,
                                 placeholder: account.display_name.presence || account.username, hint: game_t('admin.games.characters.name_hint')
      = render 'admin/ui/field', label: game_t('admin.games.manage.detail.memo'), name: 'game_character[note]', id: 'game_character_note', value: @character.note, wide: true, html: { maxlength: 2000 }

    - if stats_defined
      %section.gd-card
        %h2.gd-card__title= game_t('admin.games.manage.detail.stats')
        = render layout: 'admin/ui/fields' do
          - @base_stats.each do |stat|
            = render 'admin/ui/field', label: stat.name, name: "game_character[stat_values][#{stat.name}]", id: "stat_#{stat.id}", value: @character.raw_stat_value(stat), type: :number,
                                       hint: game_t('admin.games.manage.detail.range', min: stat.min, max: stat.max), html: { min: stat.min, max: stat.max }
        - if @character.active_effects.reject { |effect| effect['kind'] == 'fx' }.any?
          %p.hint
            = game_t('admin.games.manage.detail.effects')
            = @character.active_effects.reject { |effect| effect['kind'] == 'fx' }.map { |effect| "#{effect['kind'] == 'wear' ? effect['label'] : "#{effect['stat']} #{format('%+d', effect['delta'].to_i)}"} (#{l(Time.zone.parse(effect['until']), format: :short)}까지, #{effect['item']})" }.join(', ')
        - if @statuses.any?
          .gd-status-list
            - @statuses.each do |status|
              .gd-status
                %span= status.name
                %strong= @character.status_value(status, @base_stats) || '-'
                %small= status.formula.gsub(/\{\{\s*([^{}]+?)\s*\}\}/, '\1')

    - if @counters.any?
      %section.gd-card
        %h2.gd-card__title= game_t('admin.games.manage.detail.counters')
        = render layout: 'admin/ui/fields' do
          - @counters.each do |counter|
            - hint = counter.opposite ? game_t('admin.games.manage.detail.counter_net', opposite: counter.opposite.name, net: counter.net_for(@character)) : nil
            = render 'admin/ui/field', label: counter.name, name: "game_character[counter_values][#{counter.id}]", id: "counter_#{counter.id}", value: counter.raw_for(@character), type: :number,
                                       hint: hint, html: { min: 0 }
        %p.hint= game_t('admin.games.manage.detail.counters_hint')

    .gd-actions
      = button_tag t('generic.save_changes'), type: :submit, class: 'gd-button'

  -# 재화: 입력한 값으로 맞춘다 (바뀐 만큼이 재화 내역에 남는다)
  %section.gd-card
    %h2.gd-card__title= @currency
    = form_tag money_admin_game_character_path(@character, filter_params), method: :patch, class: 'simple_form' do
      = render layout: 'admin/ui/fields' do
        = render 'admin/ui/field', label: game_t('admin.games.manage.detail.money_now'), name: 'money', id: 'character_money', value: @character.money, type: :number, html: { min: 0 }
        = render 'admin/ui/field', label: game_t('admin.games.manage.detail.money_reason_label'), name: 'reason', id: 'character_money_reason', value: '', html: { maxlength: 200 }
      = button_tag t('generic.save_changes'), type: :submit, class: 'gd-button'

  -# 인벤토리: 아이템 카드 (그림 + 개수 배지 + 이름). 누르면 모달에서 고치기·지우기, 바로 저장된다
  %section.gd-card
    %h2.gd-card__title
      = game_t('admin.games.manage.detail.inventory')
      %span.game-table__count= game_t('admin.games.manage.detail.summary_items', count: @character.item_count)
    .game-inventory
      - Array(@character.inventory).each_with_index do |item, index|
        - image = @item_images[Game::Wallet.key(item['name'])]
        %button.game-inventory__card{ type: 'button', title: item['note'].presence, data: { modal_open: "item-#{index}" } }
          .game-inventory__image
            = render 'admin/game_characters/item_thumb', name: item['name'], image: image&.image&.url(:small)
            %span.game-inventory__count= "×#{item['count']}"
          %span.game-inventory__name= item['name']
      %button.game-inventory__card.game-inventory__card--add{ type: 'button', data: { modal_open: 'item-add' } }
        .game-inventory__image= material_symbol('add')
        %span.game-inventory__name= game_t('admin.games.manage.detail.add_item')

  -# 붙은 칭호·데코: 미리보기·이름·남은 시간(고치기)·지우기
  %section.gd-card
    %h2.gd-card__title= game_t('admin.games.fx.entries_title')
    - entries = @character.fx_entries
    - if entries.empty?
      %p.hint= game_t('admin.games.fx.no_entries')
    - effects_by_id = GameEffect.unscoped.index_by(&:id)
    - entries.each do |index, entry|
      = render 'admin/game_effects/entry', effect: effects_by_id[entry['effect_id'].to_i], entry: entry, id: "character_fx_#{index}",
                                           update_url: effect_admin_game_character_path(@character, index, filter_params), delete_url: effect_admin_game_character_path(@character, index, filter_params)
    = render 'admin/game_effects/add_form', url: add_effect_admin_game_character_path(@character, filter_params), kind: 'character', id: 'character_fx'

%datalist#game-shop-item-names
  - @shop_item_names.each do |name|
    %option{ value: name }

= render layout: 'admin/ui/modal', locals: { id: 'item-add', title: game_t('admin.games.manage.detail.add_item') } do
  = form_tag items_admin_game_character_path(@character, filter_params), method: :post, class: 'simple_form' do
    = render 'admin/game_characters/item_fields', item: { 'name' => '', 'count' => 1, 'note' => '' }, prefix: 'item_new', named: true
    .actions
      %button.button.button-tertiary{ type: 'button', data: { modal_close: true } }= t('generic.cancel')
      = button_tag game_t('admin.games.manage.detail.add_item'), type: :submit, class: 'button'

- Array(@character.inventory).each_with_index do |item, index|
  - image = @item_images[Game::Wallet.key(item['name'])]
  = render layout: 'admin/ui/modal', locals: { id: "item-#{index}", title: item['name'] } do
    .game-inventory__modal-head
      = render 'admin/game_characters/item_thumb', name: item['name'], image: image&.image&.url(:small)
      - if image&.description.present?
        %p.hint= image.description
    = form_tag item_admin_game_character_path(@character, index, filter_params), method: :patch, class: 'simple_form' do
      = hidden_field_tag :original_name, item['name'], id: nil
      = render 'admin/game_characters/item_fields', item: item, prefix: "item_#{index}", named: false
      .actions
        %button.button.button-tertiary{ type: 'button', data: { modal_close: true } }= t('generic.cancel')
        = button_tag t('generic.save_changes'), type: :submit, class: 'button'
    = button_to item_admin_game_character_path(@character, index, filter_params), method: :delete, params: { original_name: item['name'] },
                class: 'button button--destructive game-inventory__remove', data: { confirm: game_t('admin.games.manage.detail.remove_item_confirm', name: item['name']) } do
      = material_symbol('delete')
      = game_t('admin.games.manage.detail.remove_item')
