- content_for :page_title do
  = t("admin.bot_sheets.sheets.#{@bot_sheet.sheet}")

- content_for :heading do
  = render 'admin/bot_sheets/heading', sheet_url: @bot_sheet.url, save_form: (@settings.present? ? 'edit_bot_sheet' : nil)

- if @error
  .flash-message.alert
    %strong= t(@error.is_a?(BotSheets::AccessError) ? 'admin.bot_sheets.errors.access' : 'admin.bot_sheets.errors.read_failed')
    %br
    = @error.message
  %p.muted-hint= t('admin.bot_sheets.errors.hint_html', path: admin_bot_sheet_connection_path)
- else
  .bot-sheet-worksheets
    - @worksheets.each do |worksheet|
      = link_to worksheet, admin_bot_sheet_path(@bot_sheet.sheet, worksheet: worksheet), class: ('selected' if worksheet == @worksheet)

  -# 마스토돈으로 옮긴 워크시트가 시트에 남아 있으면 지워도 된다고 알린다
  - if Array(@moved_worksheets).any?
    %p.hint.bot-sheet-moved= t('admin.bot_sheets.moved.worksheets_html', names: @moved_worksheets.join(', '), characters: admin_game_characters_path, shop: admin_game_shops_path)

  - if @bot_sheet.settings? && @worksheet == BotSheets::SETTINGS_WORKSHEET
    - if @settings.nil?
      %p.muted-hint= t('admin.bot_sheets.settings.no_header', headers: BotSheets::SETTINGS_HEADERS.values.join(' | '))
    - else
      %p.hint= t('admin.bot_sheets.moved.settings_html', shop: admin_game_shops_path, settings: admin_game_setting_path('common'))
      = form_tag admin_bot_sheet_path(@bot_sheet.sheet), method: :patch, id: 'edit_bot_sheet', class: 'simple_form bot-sheet-settings' do
        - BotSheets.group_settings(@settings).each do |group, items|
          %h4= t("admin.bot_sheets.settings.groups.#{group}")
          .bot-sheet-fields
            - items.each do |item|
              = render 'admin/bot_sheets/setting_item', item: item

        .actions
          = button_tag t('generic.save_changes'), type: :submit, class: 'button'

  - elsif @table
    - width = @table.width
    .game-toolbar
      .bot-sheet-notes
        - @table.notes.each do |note|
          %p= note
        - if @hidden_help.to_i.positive?
          %p= t('admin.bot_sheets.moved.help_html', count: @hidden_help, shop: admin_game_shops_path)
      = button_tag safe_join([material_symbol('add'), t('admin.bot_sheets.rows.add')]), type: :button, class: 'button', data: { modal_open: 'sheet-row-add' }

    .bot-sheet-table
      %table.table
        %thead
          %tr
            - Array.new(width) { |index| @table.header[index].to_s }.each do |cell|
              %th= cell
            %th.bot-sheet-table__actions
        %tbody
          - @table.rows.each do |row|
            - cells = Array.new(width) { |index| row.cells[index].to_s }
            %tr
              - cells.each do |cell|
                %td.bot-sheet-table__text= cell
              %td.bot-sheet-table__actions
                = button_tag material_symbol('edit'), type: :button, class: 'icon-button', title: t('admin.bot_sheets.rows.edit'), data: { modal_open: "sheet-row-#{row.number}" }
                = button_to rows_admin_bot_sheet_path(@bot_sheet.sheet), method: :delete, params: { worksheet: @worksheet, row: row.number, original: cells }, class: 'icon-button', title: t('admin.bot_sheets.rows.delete'), form_class: 'bot-sheet-table__delete', data: { confirm: t('admin.bot_sheets.rows.delete_confirm') } do
                  = material_symbol('delete')
          - if @table.rows.empty?
            %tr
              %td.bot-sheet-table__text{ colspan: width + 1 }= t('admin.bot_sheets.empty')

    -# 줄 추가·수정 모달: 헤더마다 입력칸 (빈 헤더 칸·수식 칸은 그대로 둔다)
    = render layout: 'admin/game_characters/modal', locals: { id: 'sheet-row-add', title: t('admin.bot_sheets.rows.title') } do
      = form_tag rows_admin_bot_sheet_path(@bot_sheet.sheet), method: :post, class: 'simple_form game-modal__form' do
        = hidden_field_tag :worksheet, @worksheet, id: nil
        = render 'admin/bot_sheets/row_fields', table: @table, cells: [], locked: [], prefix: 'new'
        .actions
          %button.button.button-tertiary{ type: 'button', data: { modal_close: true } }= t('generic.cancel')
          = button_tag safe_join([material_symbol('add'), t('admin.bot_sheets.rows.add')]), type: :submit, class: 'button'

    - @table.rows.each do |row|
      - cells = Array.new(width) { |index| row.cells[index].to_s }
      = render layout: 'admin/game_characters/modal', locals: { id: "sheet-row-#{row.number}", title: t('admin.bot_sheets.rows.edit') } do
        = form_tag rows_admin_bot_sheet_path(@bot_sheet.sheet), method: :patch, class: 'simple_form game-modal__form' do
          = hidden_field_tag :worksheet, @worksheet, id: nil
          = hidden_field_tag :row, row.number, id: nil
          - cells.each do |cell|
            = hidden_field_tag 'original[]', cell, id: nil
          = render 'admin/bot_sheets/row_fields', table: @table, cells: cells, locked: @formulas.fetch(row.number, []), prefix: "row_#{row.number}"
          .actions
            %button.button.button-tertiary{ type: 'button', data: { modal_close: true } }= t('generic.cancel')
            = button_tag t('generic.save_changes'), type: :submit, class: 'button'

  - elsif @rows.blank?
    %p.muted-hint= t('admin.bot_sheets.empty')
  - else
    .bot-sheet-notes
      - @rows.flatten.compact_blank.each do |note|
        %p= note
