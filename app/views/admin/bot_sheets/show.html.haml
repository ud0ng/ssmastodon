- content_for :page_title do
  = t("admin.bot_sheets.sheets.#{@bot_sheet.sheet}")

- content_for :heading do
  = render 'admin/bot_sheets/heading', sheet_url: @bot_sheet.url, save_form: (@settings.present? ? 'edit_bot_sheet' : nil)

- if @error
  .flash-message.alert
    %strong= t(@error.is_a?(BotSheets::AccessError) ? 'admin.bot_sheets.errors.access' : 'admin.bot_sheets.errors.read_failed')
    %br
    = @error.message
  %p.muted-hint= t('admin.bot_sheets.errors.hint_html', path: admin_bot_sheet_connection_path)
- else
  .bot-sheet-worksheets
    - @worksheets.each do |worksheet|
      = link_to worksheet, admin_bot_sheet_path(@bot_sheet.sheet, worksheet: worksheet), class: ('selected' if worksheet == @worksheet)

  - if @bot_sheet.settings? && @worksheet == BotSheets::SETTINGS_WORKSHEET
    - if @settings.nil?
      %p.muted-hint= t('admin.bot_sheets.settings.no_header', headers: BotSheets::SETTINGS_HEADERS.values.join(' | '))
    - else
      %p.hint= t('admin.bot_sheets.settings.hint')
      = form_tag admin_bot_sheet_path(@bot_sheet.sheet), method: :patch, id: 'edit_bot_sheet', class: 'simple_form bot-sheet-settings' do
        - BotSheets.group_settings(@settings).each do |group, items|
          %h4= t("admin.bot_sheets.settings.groups.#{group}")
          .bot-sheet-fields
            - items.each do |item|
              = render 'admin/bot_sheets/setting_item', item: item

        .actions
          = button_tag t('generic.save_changes'), type: :submit, class: 'button'

  - elsif @table
    - if @table.notes.any?
      .bot-sheet-notes
        - @table.notes.each do |note|
          %p= note

    - width = @table.width
    - if @table.rows.empty?
      %p.muted-hint= t('admin.bot_sheets.empty')
    - if @editing
      -# 고치는 줄의 입력칸은 표 안에 있고, form 속성으로 이 폼에 붙는다
      = form_tag rows_admin_bot_sheet_path(@bot_sheet.sheet), method: :patch, id: 'edit_bot_sheet_row' do
        = hidden_field_tag :worksheet, @worksheet, id: nil
        = hidden_field_tag :row, @editing.number, id: nil
        - Array.new(width) { |index| @editing.cells[index].to_s }.each do |cell|
          = hidden_field_tag 'original[]', cell, id: nil

    .bot-sheet-table
      %table.table
        %thead
          %tr
            - Array.new(width) { |index| @table.header[index].to_s }.each do |cell|
              %th= cell
            %th.bot-sheet-table__actions
        %tbody
          - @table.rows.each do |row|
            - cells = Array.new(width) { |index| row.cells[index].to_s }
            - if row == @editing
              %tr.bot-sheet-table__editing
                - cells.each_with_index do |cell, index|
                  %td
                    - if @table.header[index].to_s.strip.empty? || @editing_formulas.include?(index)
                      = hidden_field_tag 'cells[]', cell, form: 'edit_bot_sheet_row', id: nil
                      %span.bot-sheet-table__locked{ title: (t('admin.bot_sheets.settings.formula') if @editing_formulas.include?(index)) }= cell
                    - else
                      = text_field_tag 'cells[]', cell, form: 'edit_bot_sheet_row', id: nil, 'aria-label': @table.header[index], class: 'bot-sheet-table__input'
                %td.bot-sheet-table__actions
                  = button_tag material_symbol('check'), type: :submit, form: 'edit_bot_sheet_row', class: 'icon-button', title: t('generic.save_changes')
                  = link_to material_symbol('close'), admin_bot_sheet_path(@bot_sheet.sheet, worksheet: @worksheet), class: 'icon-button', title: t('generic.cancel')
            - else
              %tr
                - cells.each do |cell|
                  %td.bot-sheet-table__text= cell
                %td.bot-sheet-table__actions
                  = link_to material_symbol('edit'), admin_bot_sheet_path(@bot_sheet.sheet, worksheet: @worksheet, edit: row.number, anchor: "row-#{row.number}"), class: 'icon-button', title: t('admin.bot_sheets.rows.edit'), id: "row-#{row.number}"
                  = button_to rows_admin_bot_sheet_path(@bot_sheet.sheet), method: :delete, params: { worksheet: @worksheet, row: row.number, original: cells }, class: 'icon-button', title: t('admin.bot_sheets.rows.delete'), form_class: 'bot-sheet-table__delete', data: { confirm: t('admin.bot_sheets.rows.delete_confirm') } do
                    = material_symbol('delete')

    = form_tag rows_admin_bot_sheet_path(@bot_sheet.sheet), method: :post, class: 'simple_form bot-sheet-add-row' do
      = hidden_field_tag :worksheet, @worksheet
      %h4= t('admin.bot_sheets.rows.title')
      .bot-sheet-fields
        - @table.header.each_with_index do |name, index|
          - if name.strip.present?
            -# 내용이 긴 열(설명·문구 등)은 넓게
            .input.string.with_label{ class: ('bot-sheet-field--wide' if @table.rows.any? { |row| row.cells[index].to_s.size > 20 }) }
              .label_input
                %label{ for: "bot_sheet_cell_#{index}" }= name
                .label_input__wrapper
                  = text_field_tag 'cells[]', '', id: "bot_sheet_cell_#{index}"
          - else
            = hidden_field_tag 'cells[]', '', id: nil
      .actions
        = button_tag safe_join([material_symbol('add'), t('admin.bot_sheets.rows.add')]), type: :submit, class: 'button'

  - elsif @rows.blank?
    %p.muted-hint= t('admin.bot_sheets.empty')
  - else
    .bot-sheet-notes
      - @rows.flatten.compact_blank.each do |note|
        %p= note
