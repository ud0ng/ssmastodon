- kind = Game::Kinds.registry[@key]
- title = { 'common' => game_t("admin.games.tabs.#{@page}"), 'lessons' => game_t('admin.games.tabs.lessons') }.fetch(@key) { kind.display_name }
- content_for :page_title do
  = title

- content_for :heading do
  = render 'admin/game_settings/heading', save_form: 'edit_game_config'

-# 컨텐츠·과목 화면: 같은 묶음의 다른 컨텐츠로 바로 가는 칩 줄 + 한 줄 안내
- if kind
  - siblings = kind.lesson? ? Game::Lessons.all : Game::Kinds.all.reject(&:lesson?)
  .game-switcher
    = link_to (kind.lesson? ? admin_game_setting_path('lessons') : admin_game_settings_path), class: 'game-switcher__back' do
      = material_symbol 'chevron_left'
      = kind.lesson? ? game_t('admin.games.tabs.lessons') : game_t('admin.games.tabs.list')
    - siblings.each do |other|
      = link_to admin_game_setting_path(other.key), class: ['game-switcher__chip', ('game-switcher__chip--active' if other == kind), ('game-switcher__chip--off' unless other.enabled?)] do
        %span{ 'aria-hidden': 'true' }= game_kind_icon(other.key)
        = other.display_name
  %p.hint.game-config__hint
    = game_t(kind.lesson? ? 'admin.games.lesson_hint' : 'admin.games.kind_hint')
    - if !kind.lesson? && !kind.event?
      %span.game-config__flow= [game_t('admin.games.flow.invite', command: kind.config['command']), game_t('admin.games.flow.accept'), game_t('admin.games.flow.play'), game_t('admin.games.flow.result')].join(' → ')
- elsif @key == 'lessons'
  -# 수업: 과목으로 바로 가는 칩
  .game-switcher
    - Game::Lessons.all.each do |other|
      = link_to admin_game_setting_path(other.key), class: ['game-switcher__chip', ('game-switcher__chip--off' unless other.enabled?)] do
        %span{ 'aria-hidden': 'true' }= game_kind_icon(other.key)
        = other.display_name

- system = Game::System.account
- shop_item_names = GameShopItem.pluck(:name)
= form_tag admin_game_setting_path(params[:id]), method: :patch, id: 'edit_game_config', class: 'simple_form game-config',
  data: { game_config: true, samples: game_preview_samples(title).to_json,
          system_name: system&.display_name.presence || system&.username || 'system', system_avatar: system ? full_asset_url(system.avatar_static_url) : '',
          changed_label: game_t('admin.games.changed'), reset_label: game_t('admin.games.reset_default'),
          chips_placeholder: game_t('admin.games.chips_placeholder'), unknown_label: game_t('admin.games.unknown_tokens'),
          split_labels: [game_t('admin.games.split.perfect'), game_t('admin.games.split.half'), game_t('admin.games.split.fail'), game_t('admin.games.split.over')].to_json } do
  -# 공통 설정(설정·명령어)은 프로필 화면처럼 소제목 + 칸, 그 밖에는 접었다 펴는 묶음
  - @sections.each do |section, fields|
    - messages = fields.any? { |field| field.type == :text }
    %details.game-group{ class: ('game-group--plain' if @page), open: @page.present? || !(messages && fields.size > 6), data: { group: section } }
      %summary.game-group__summary
        %span.game-group__title= game_t("admin.games.sections.#{section}", default: game_t("admin.games.groups.#{section}", default: section))
        %span.game-group__count= game_t('admin.games.fields_count', count: fields.size)
        %span.game-group__changed{ hidden: true }
      .game-group__body
        - if messages
          -# 문구에 넣는 명령어 배지: 사람 · 값 · 조사
          .game-tokens__legend
            %span.hint= game_t('admin.games.messages_hint')
            %span.game-token.game-token--person= '{계정명}'
            %span.game-token= '{컨텐츠}'
            %span.game-token.game-token--particle= '{이가}'
        .bot-sheet-fields
          - fields.each do |field|
            - name = "config[#{field.key}]"
            - field_id = "game_config_#{field.key}"
            - value = @values[field.key]
            - default = field.type == :lines ? Array(field.default).join("\n") : field.default
            - items_field = field.type == :lines && field.key.start_with?('reward_items')
            - wrapper_data = { game_field: items_field ? 'items' : field.type, default: default.to_s, field_label: field.label }
            - if field.type == :boolean
              .bot-sheet-field.bot-sheet-field--switch.game-field{ data: wrapper_data.merge(default: field.default ? '1' : '0') }
                = hidden_field_tag name, '0', id: nil
                %label.bot-sheet-switch{ for: field_id }
                  = check_box_tag name, '1', value, id: field_id, role: 'switch'
                  %span.bot-sheet-switch__track
                  %span.bot-sheet-switch__label= field.label
                - if field.hint
                  %span.hint= field.hint
            - else
              .bot-sheet-field.input.with_label.game-field{ class: ('game-config__full' if %i(text lines).include?(field.type)), data: wrapper_data.merge(percent: (field.type == :integer && field.label.to_s.include?('%')) ? true : nil, tokens: (field.type == :text ? (field.tokens + Game::Text::PARTICLES.keys).to_json : nil)) }
                .label_input
                  %label{ for: field_id }= field.label
                  .label_input__wrapper
                    - case field.type
                    - when :account
                      -# 회원 아이디: 가입한 회원 목록에서 고른다
                      - choices = @accounts.map { |account| ["#{account.display_name.presence || account.username} (@#{account.username})", account.username] }
                      - choices.unshift(["@#{value}", value]) if value.present? && choices.none? { |_, username| username == value }
                      = select_tag name, options_for_select([[game_t('admin.games.pick_account'), '']] + choices, value), id: field_id
                    - when :select
                      = select_tag name, options_for_select(field.choices.map(&:reverse), value), id: field_id
                    - when :integer
                      = number_field_tag name, value, id: field_id, step: 1
                    - when :lines
                      - if items_field
                        -# 보상 아이템: 상점 아이템을 골라 개수·확률을 적는 표 (game_config_editor.ts setupStatsEditor)
                        - editor = { columns: [game_t('admin.games.reward_item.name'), game_t('admin.games.reward_item.count'), game_t('admin.games.reward_item.chance')], sep: '|', choices: shop_item_names, choice_placeholder: game_t('admin.games.reward_item.pick') }
                        = text_area_tag name, Array(value).join("\n"), id: field_id, rows: 3, data: { stats_editor: editor.to_json }
                      - else
                        = text_area_tag name, Array(value).join("\n"), id: field_id, rows: [Array(value).size + 1, 4].max
                    - when :text
                      = text_area_tag name, value, id: field_id, rows: [value.to_s.lines.size + 1, 2].max
                    - else
                      = text_field_tag name, value, id: field_id
                - if items_field
                  %span.hint= game_t('admin.games.reward_item.hint')
                - elsif field.hint
                  %span.hint= field.hint
                - if field.type == :text
                  -# 누르면 커서 자리에 들어가는 명령어 (admin.tsx), 미리보기는 game_config_editor.ts 가 붙인다
                  .game-tokens
                    - (field.tokens + Game::Text::PARTICLES.keys).each do |token|
                      %button.game-token{ type: 'button', data: { insert: "{#{token}}", target: field_id }, class: [('game-token--particle' if Game::Text::PARTICLES.key?(token)), ('game-token--person' if token.include?('계정'))] }= "{#{token}}"

  -# 저장하지 않은 변경이 있으면 화면 아래에 붙는 저장 줄 (game_config_editor.ts)
  .game-savebar{ hidden: true }
    %span.game-savebar__text{ data: { template: game_t('admin.games.unsaved') } }
    %button.button.button-secondary.game-savebar__reset{ type: 'button' }= game_t('admin.games.undo_all')
    = button_tag t('generic.save_changes'), type: :submit, class: 'button'

  .actions
    = button_tag t('generic.save_changes'), type: :submit, class: 'button'
