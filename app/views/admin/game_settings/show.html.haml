- kind = Game::Kinds.registry[@key]
- title = { 'common' => game_t("admin.games.tabs.#{@page}"), 'lessons' => game_t('admin.games.tabs.lessons') }.fetch(@key) { kind.display_name }
- content_for :page_title do
  = title

- content_for :heading do
  = render 'admin/game_settings/heading', save_form: 'edit_game_config'

-# 컨텐츠·과목 화면: 같은 묶음의 다른 컨텐츠로 바로 가는 칩 줄 + 한 줄 안내
- if kind
  - siblings = kind.lesson? ? Game::Lessons.all : Game::Kinds.all.reject(&:lesson?)
  .game-switcher
    = link_to (kind.lesson? ? admin_game_setting_path('lessons') : admin_game_settings_path), class: 'game-switcher__back' do
      = material_symbol 'chevron_left'
      = kind.lesson? ? game_t('admin.games.tabs.lessons') : game_t('admin.games.tabs.list')
    - siblings.each do |other|
      = link_to admin_game_setting_path(other.key), class: ['game-switcher__chip', ('game-switcher__chip--active' if other == kind), ('game-switcher__chip--off' unless other.enabled?)] do
        %span{ 'aria-hidden': 'true' }= game_kind_icon(other.key)
        = other.display_name
  %p.hint.game-config__hint
    = game_t(kind.lesson? ? 'admin.games.lesson_hint' : 'admin.games.kind_hint')
    - if !kind.lesson? && !kind.event?
      %span.game-config__flow= [game_t('admin.games.flow.invite', command: kind.config['command']), game_t('admin.games.flow.accept'), game_t('admin.games.flow.play'), game_t('admin.games.flow.result')].join(' → ')
- elsif @key == 'lessons'
  -# 수업: 과목으로 바로 가는 칩
  .game-switcher
    - Game::Lessons.all.each do |other|
      = link_to admin_game_setting_path(other.key), class: ['game-switcher__chip', ('game-switcher__chip--off' unless other.enabled?)] do
        %span{ 'aria-hidden': 'true' }= game_kind_icon(other.key)
        = other.display_name

- system = Game::System.account
= form_tag admin_game_setting_path(params[:id]), method: :patch, id: 'edit_game_config', class: 'simple_form game-config',
  data: { game_config: true, samples: game_preview_samples(title).to_json,
          system_name: system&.display_name.presence || system&.username || 'system', system_avatar: system ? full_asset_url(system.avatar_static_url) : '',
          changed_label: game_t('admin.games.changed'), reset_label: game_t('admin.games.reset_default'),
          chips_placeholder: game_t('admin.games.chips_placeholder'), unknown_label: game_t('admin.games.unknown_tokens'),
          split_labels: [game_t('admin.games.split.perfect'), game_t('admin.games.split.half'), game_t('admin.games.split.fail'), game_t('admin.games.split.over')].to_json } do
  -# 프로필 설정 화면처럼 소제목(admin/ui/section) + 칸(admin/ui/field)
  - @sections.each do |section, fields|
    - messages = fields.any? { |field| field.type == :text }
    - changed = capture do
      %span.game-group__changed{ hidden: true }
    = render layout: 'admin/ui/section', locals: { title: game_t("admin.games.sections.#{section}", default: game_t("admin.games.groups.#{section}", default: section)), actions: changed } do
      - if messages
        -# 문구에 넣는 명령어 배지: 사람 · 값 · 조사
        .game-tokens__legend
          %span.hint= game_t('admin.games.messages_hint')
          %span.game-token.game-token--person= '{계정명}'
          %span.game-token= '{컨텐츠}'
          %span.game-token.game-token--particle= '{이가}'
      -# 줄을 나눠 보여 줄 칸(Game::Config::ROW_STARTS) 앞에서 새 줄
      - rows = fields.slice_before { |field| Game::Config::ROW_STARTS.include?(field.key) }
      - rows.each do |row|
        = render layout: 'admin/ui/fields' do
          - row.each do |field|
            = render 'admin/game_settings/config_field', field: field

  -# 설정 탭: 컨텐츠마다 승리·무승부·패배 점수를 한 표에서
  - if @points_kinds
    = render layout: 'admin/ui/section', locals: { title: game_t('admin.games.points_table.title'), hint: game_t("admin.games.points_table.hint_#{@scoring_mode}") } do
      .bot-sheet-table.game-table
        %table.table
          %thead
            %tr
              %th= game_t('admin.games.points_table.content')
              - %w(win draw lose).each do |outcome|
                %th.game-table__number= game_t("admin.games.points_table.#{outcome}")
          %tbody
            - @points_kinds.each do |kind|
              - config = kind.config
              %tr
                %td.bot-sheet-table__text
                  %span{ 'aria-hidden': 'true' }= game_kind_icon(kind.key)
                  = kind.display_name
                - %w(win draw lose).each do |outcome|
                  %td.game-table__number
                    = number_field_tag "points[#{kind.key}][#{outcome}]", config["points_#{outcome}"], step: 1, min: 0, class: 'ui-input ui-input--number game-points__input', 'aria-label': "#{kind.display_name} #{game_t("admin.games.points_table.#{outcome}")}"

  -# 저장하지 않은 변경이 있으면 화면 아래에 붙는 저장 줄 (game_config_editor.ts)
  .game-savebar{ hidden: true }
    %span.game-savebar__text{ data: { template: game_t('admin.games.unsaved') } }
    %button.button.button-secondary.game-savebar__reset{ type: 'button' }= game_t('admin.games.undo_all')
    = button_tag t('generic.save_changes'), type: :submit, class: 'button'

  .actions
    = button_tag t('generic.save_changes'), type: :submit, class: 'button'
