-# 수업 > 설정 > 소속 점수 및 보상: 등급마다 소속 점수 · 그 사람에게 주는 재화 · 아이템 (한 표)
- currency = Game::Config.for('common')['currency_name']
- editor = { columns: [game_t('admin.games.reward_item.name'), game_t('admin.games.reward_item.count'), game_t('admin.games.reward_item.chance')], sep: '|', choices: @shop_item_names, choice_placeholder: game_t('admin.games.reward_item.pick') }
%p.ui-section__hint= game_t('admin.games.lessons_ui.grades_hint')
.bot-sheet-table.game-table.game-grades
  %table.table
    %thead
      %tr
        %th= game_t('admin.games.lessons_ui.grade')
        %th.game-table__number= game_t('admin.games.lessons_ui.points')
        %th.game-table__number= game_t('admin.games.lessons_ui.money', currency: currency)
        %th= game_t('admin.games.lessons_ui.items')
    %tbody
      - Game::Lessons::GRADE_NAMES.each do |grade, grade_name|
        %tr
          %td.bot-sheet-table__text
            %strong= grade
            %span.hint= grade_name
          %td.game-table__number
            = number_field_tag "config[points_#{grade}]", @values["points_#{grade}"], step: 1, class: 'ui-input ui-input--number game-points__input', 'aria-label': "#{grade} #{game_t('admin.games.lessons_ui.points')}"
          %td.game-table__number
            = number_field_tag "config[reward_money_#{grade}]", @values["reward_money_#{grade}"], step: 1, min: 0, class: 'ui-input ui-input--number game-points__input', 'aria-label': "#{grade} #{currency}"
          %td.game-grades__items
            = text_area_tag "config[reward_items_#{grade}]", Array(@values["reward_items_#{grade}"]).join("\n"), id: "game_config_reward_items_#{grade}", rows: 2, class: 'ui-input ui-input--textarea', data: { stats_editor: editor.to_json }, 'aria-label': "#{grade} #{game_t('admin.games.lessons_ui.items')}"
%p.hint= game_t('admin.games.reward_item.hint')
