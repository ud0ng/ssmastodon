-# 이벤트 열기: 운영진이 누르면 시스템 계정이 모집 툿을 올리고 모두의 컨텐츠 메뉴에 알림 배지가 뜬다 (모집형 컨텐츠 + 비밀의 방)
- recruiting = GameSession.current_kinds.where(status: 'pending').where("state->>'mode' = 'event'").first
= render layout: 'admin/ui/section', locals: { title: game_t('admin.games.events.title') } do
  %p.hint= game_t('admin.games.events.hint')
  - if recruiting
    %p.hint
      %span.game-badge= game_t('admin.games.events.recruiting')
      = game_t('admin.games.events.recruiting_now', name: recruiting.kind_class&.display_name || recruiting.kind, count: recruiting.players.size, time: (recruiting.deadline_at ? l(recruiting.deadline_at, format: :short) : '-'))
  .bot-sheet-table.game-table
    %table.table
      %tbody
        - Game::Events::Opening.kinds.each do |kind|
          %tr
            %td.bot-sheet-table__text
              %span.game-table__icon{ 'aria-hidden': 'true' }= game_kind_icon(kind.key)
              %strong= kind.display_name
            %td.bot-sheet-table__text
              - limits = kind.event? ? [kind.config['min_players'], kind.config['max_players']] : [kind.config['event_min_players'], kind.config['event_max_players']]
              - minutes = kind.event? ? kind.config['join_minutes'] : kind.config['event_join_minutes']
              = game_t('admin.games.events.summary', minutes: minutes, min: limits[0], max: limits[1])
            %td.bot-sheet-table__actions
              = button_to game_t('admin.games.events.open'), admin_game_event_path, params: { kind: kind.key }, method: :post, class: 'button',
                          disabled: !kind.enabled? || recruiting.present?, data: { confirm: game_t('admin.games.events.confirm', name: kind.display_name) }
