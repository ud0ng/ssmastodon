- content_for :page_title do
  = game_t('admin.games.tournaments.title')

- content_for :heading do
  = render 'admin/game_settings/heading'

%p.hint= game_t('admin.games.tournaments.hint')

- if @tournaments.any?
  .bot-sheet-table
    %table.table
      %thead
        %tr
          %th= game_t('admin.games.tournaments.name')
          %th= game_t('admin.games.tournaments.size')
          %th= game_t('admin.games.tournaments.status')
          %th= game_t('admin.games.tournaments.champion')
          %th.bot-sheet-table__actions
      %tbody
        - @tournaments.each do |tournament|
          %tr
            %td.bot-sheet-table__text= link_to tournament.name, admin_game_tournament_path(tournament)
            %td.bot-sheet-table__text= game_t('admin.games.tournaments.people', count: tournament.size)
            %td.bot-sheet-table__text= game_t("admin.games.tournaments.statuses.#{tournament.status}")
            %td.bot-sheet-table__text= tournament.winner_house&.label || '—'
            %td.bot-sheet-table__actions
              = link_to material_symbol('edit'), admin_game_tournament_path(tournament), class: 'icon-button', title: game_t('admin.games.tournaments.edit')
              = button_to admin_game_tournament_path(tournament), method: :delete, class: 'icon-button', form_class: 'bot-sheet-table__delete', title: game_t('admin.games.tournaments.delete'), data: { confirm: game_t('admin.games.tournaments.delete_confirm', name: tournament.name) } do
                = material_symbol('delete')

= form_tag admin_game_tournaments_path, method: :post, class: 'simple_form bot-sheet-add-row' do
  %h4= game_t('admin.games.tournaments.new')
  .bot-sheet-fields
    .input.with_label.bot-sheet-field--wide
      .label_input
        %label{ for: 'new_tournament_name' }= game_t('admin.games.tournaments.name')
        .label_input__wrapper= text_field_tag 'game_tournament[name]', '', id: 'new_tournament_name', required: true, placeholder: game_t('admin.games.tournaments.name_placeholder')
    .input.with_label
      .label_input
        %label{ for: 'new_tournament_size' }= game_t('admin.games.tournaments.size')
        .label_input__wrapper= select_tag 'game_tournament[size]', options_for_select(GameTournament::SIZES.map { |size| [game_t('admin.games.tournaments.people', count: size), size] }, 8), id: 'new_tournament_size'
    .input.with_label
      .label_input
        %label{ for: 'new_tournament_reward' }= game_t('admin.games.tournaments.reward')
        .label_input__wrapper= number_field_tag 'game_tournament[reward]', 50, id: 'new_tournament_reward', min: 0
  .actions
    = button_tag safe_join([material_symbol('add'), game_t('admin.games.tournaments.create')]), type: :submit, class: 'button'
