- content_for :page_title do
  = @tournament.name

- content_for :heading do
  = render 'admin/game_settings/heading'

- character_options = @characters.map { |character| ["#{character.group&.emoji} #{character.display_name} (@#{character.account.username})".strip, character.account_id] }
- kind_options = @kinds.map { |kind| [kind.display_name, kind.key] }
- seoul = ActiveSupport::TimeZone['Asia/Seoul']

.game-tournament__head
  = form_tag admin_game_tournament_path(@tournament), method: :patch, class: 'simple_form game-tournament__settings' do
    .bot-sheet-fields
      .input.with_label.bot-sheet-field--wide
        .label_input
          %label{ for: 'tournament_name' }= game_t('admin.games.tournaments.name')
          .label_input__wrapper= text_field_tag 'game_tournament[name]', @tournament.name, id: 'tournament_name'
      .input.with_label
        .label_input
          %label{ for: 'tournament_reward' }= game_t('admin.games.tournaments.reward')
          .label_input__wrapper= number_field_tag 'game_tournament[reward]', @tournament.reward, id: 'tournament_reward', min: 0
    .actions
      = button_tag t('generic.save_changes'), type: :submit, class: 'button button-secondary'

  .game-tournament__status
    %strong= game_t("admin.games.tournaments.statuses.#{@tournament.status}")
    - if @tournament.status == 'draft'
      %p.hint= game_t('admin.games.tournaments.start_hint')
      = button_to game_t('admin.games.tournaments.start'), start_admin_game_tournament_path(@tournament), method: :post, class: 'button', data: { confirm: game_t('admin.games.tournaments.start_confirm') }
    - elsif @tournament.status == 'finished'
      %p= game_t('admin.games.tournaments.champion_is', house: @tournament.winner_house&.label || '—')
    - unless Game::Tournament.scoring_mode?
      %p.hint= game_t('admin.games.tournaments.mode_hint')

- wins = @tournament.house_wins
- if wins.any?
  .game-tournament__tally
    - wins.sort_by { |_, count| -count }.each do |house, count|
      %span= "#{house.label} #{count}승"

-# 대진표: 라운드끼리 선으로 잇고, 경기를 누르면 오른쪽 패널에서 편집. 선수 칩을 칸에 끌어다 놓으면 바로 배치된다 (game_config_editor.ts)
- editable = ->(match) { %w(playing done).exclude?(match.status) }
.game-bracket-editor{ data: { bracket_editor: true } }
  .game-bracket.game-bracket--tree
    - (1..@tournament.rounds).each do |round|
      - matches = @tournament.round_matches(round)
      .game-bracket__round{ class: ('game-bracket__round--last' if round == @tournament.rounds) }
        %h4= @tournament.round_name(round)
        .game-bracket__pairs
          - matches.each_slice(2) do |pair|
            .game-bracket__pair{ class: ('game-bracket__pair--single' if pair.size == 1) }
              - pair.each do |match|
                .game-bracket__match{ id: "match-#{match.id}", class: "game-bracket__match--#{match.status}", tabindex: 0, role: 'button', data: { match: match.id } }
                  .game-bracket__match-head
                    %span= game_t('admin.games.tournaments.match_number', number: match.position + 1)
                    %span.game-bracket__badge= game_t("admin.games.tournaments.match_statuses.#{match.status}")
                  .game-bracket__meta
                    = match.kind_name || game_t('admin.games.tournaments.pick_content')
                    - if match.scheduled_at
                      = "· #{l(match.scheduled_at.in_time_zone(seoul), format: :short)}"
                  - [[:a, match.player_a], [:b, match.player_b]].each do |slot, player|
                    - character = player && GameCharacter.for(player)
                    .game-bracket__slot{ class: [('game-bracket__slot--winner' if player && match.winner_id == player.id), ('game-bracket__slot--empty' unless player)], style: "--house-color: #{character&.group&.color.presence || '#8a8f98'}", data: { slot: slot, match: match.id, droppable: editable.call(match) ? true : nil } }
                      - if character
                        %span.game-bracket__dot
                        = character.display_name
                      - else
                        %span.game-bracket__placeholder= game_t('admin.games.tournaments.drop_player')

  %aside.game-bracket__panel
    %p.hint.game-bracket__panel-hint= game_t('admin.games.tournaments.panel_hint')
    .game-bracket__pool
      - @characters.each do |character|
        %span.game-bracket__chip{ draggable: 'true', data: { account_id: character.account_id }, style: "--house-color: #{character.group&.color.presence || '#8a8f98'}" }
          %span.game-bracket__dot
          = character.display_name

    - (1..@tournament.rounds).flat_map { |round| @tournament.round_matches(round) }.each do |match|
      .game-bracket__edit{ hidden: true, data: { edit: match.id } }
        %h4= "#{@tournament.round_name(match.round)} · #{game_t('admin.games.tournaments.match_number', number: match.position + 1)}"
        - if editable.call(match)
          = form_tag admin_game_tournament_match_path(match), method: :patch, class: 'simple_form game-bracket__form', data: { match_form: match.id } do
            %label= game_t('admin.games.tournaments.content')
            = select_tag 'game_tournament_match[kind]', options_for_select(kind_options, match.kind), include_blank: game_t('admin.games.tournaments.pick_content'), 'aria-label': game_t('admin.games.tournaments.content')
            %label= game_t('admin.games.tournaments.time')
            = datetime_local_field_tag 'game_tournament_match[scheduled_at]', match.scheduled_at&.in_time_zone(seoul)&.strftime('%Y-%m-%dT%H:%M'), 'aria-label': game_t('admin.games.tournaments.time')
            %label= game_t('admin.games.tournaments.player')
            = select_tag 'game_tournament_match[player_a_id]', options_for_select(character_options, match.player_a_id), include_blank: game_t('admin.games.tournaments.pick_player'), 'aria-label': game_t('admin.games.tournaments.player'), data: { slot: 'a' }
            = select_tag 'game_tournament_match[player_b_id]', options_for_select(character_options, match.player_b_id), include_blank: game_t('admin.games.tournaments.pick_player'), 'aria-label': game_t('admin.games.tournaments.player'), data: { slot: 'b' }
            = button_tag t('generic.save_changes'), type: :submit, class: 'button'
        - else
          .game-bracket__summary
            %div= match.kind_name
            %div= match.scheduled_at && l(match.scheduled_at.in_time_zone(seoul), format: :short)
            - match.players.each do |player|
              .game-bracket__player{ class: ('game-bracket__player--winner' if match.winner_id == player.id) }
                = GameCharacter.for(player).group&.emoji
                = GameCharacter.for(player).display_name

        - if %w(playing judging).include?(match.status) && match.players.size == 2
          .game-bracket__decide
            %span= game_t('admin.games.tournaments.decide')
            - match.players.each do |player|
              = button_to GameCharacter.for(player).display_name, decide_admin_game_tournament_match_path(match), method: :post, params: { winner_id: player.id }, class: 'button button-secondary', data: { confirm: game_t('admin.games.tournaments.decide_confirm', name: GameCharacter.for(player).display_name) }
