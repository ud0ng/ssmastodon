- content_for :page_title do
  = @tournament.name

- content_for :heading do
  = render 'admin/game_settings/heading'

- character_options = @characters.map { |character| [[character.display_name, character.group&.name].compact.join(' · '), character.account_id] }
- kind_options = @kinds.map { |kind| [kind.display_name, kind.key] }
- seoul = ActiveSupport::TimeZone['Asia/Seoul']
- editable = ->(match) { %w(playing done).exclude?(match.status) }
- wins = @tournament.house_wins

-# 머리: 목록으로 · 이름·상태 · 고치기 · 시작
.game-toolbar.game-tournament__bar
  = link_to safe_join([material_symbol('chevron_left'), game_t('admin.games.tabs.matches')]), admin_game_tournaments_path, class: 'button button-tertiary game-detail__back'
  %h4
    = @tournament.name
    %span.game-badge{ class: "game-badge--tournament-#{@tournament.status}" }= game_t("admin.games.tournaments.statuses.#{@tournament.status}")
    %span.game-table__count= "#{game_t('admin.games.tournaments.people', count: @tournament.size)} · #{game_t('admin.games.tournaments.reward')} #{@tournament.reward}"
  = button_tag safe_join([material_symbol('edit'), game_t('admin.games.tournaments.edit_info')]), type: :button, class: 'button button-secondary', data: { modal_open: 'tournament-edit' }
  - if @tournament.status == 'draft'
    = button_to game_t('admin.games.tournaments.start'), start_admin_game_tournament_path(@tournament), method: :post, class: 'button', data: { confirm: game_t('admin.games.tournaments.start_confirm') }

- if @tournament.status == 'draft'
  %p.hint= game_t('admin.games.tournaments.start_hint')
- elsif @tournament.status == 'finished'
  %p.hint= game_t('admin.games.tournaments.champion_is', house: @tournament.winner_house&.label || '—')
- unless Game::Tournament.scoring_mode?
  %p.hint= game_t('admin.games.tournaments.mode_hint')

- if wins.any?
  .game-tournament__tally
    - wins.sort_by { |_, count| -count }.each do |house, count|
      %span.game-badge{ style: "--badge: #{house.color.presence || '#6b5b3e'}" }= "#{house.label} #{count}승"

-# 라운드마다 표 한 개. 줄마다 컨텐츠·시간·선수를 고르고 저장 (진행 중·끝난 경기는 보기만)
- (1..@tournament.rounds).each do |round|
  - matches = @tournament.round_matches(round)
  %h4.game-houses__recent= @tournament.round_name(round)
  - matches.select { |match| editable.call(match) }.each do |match|
    = form_tag admin_game_tournament_match_path(match), method: :patch, id: "match-form-#{match.id}" do
      -# 칸은 아래 표 안에 있고 form 속성으로 이 폼에 붙는다
  .bot-sheet-table.game-table.game-tournament__table
    %table.table
      %thead
        %tr
          %th= game_t('admin.games.tournaments.match')
          %th= game_t('admin.games.tournaments.content')
          %th= game_t('admin.games.tournaments.time')
          %th= game_t('admin.games.tournaments.player_a')
          %th= game_t('admin.games.tournaments.player_b')
          %th= game_t('admin.games.tournaments.status')
          %th.bot-sheet-table__actions
      %tbody
        - matches.each do |match|
          - form = "match-form-#{match.id}"
          %tr{ id: "match-#{match.id}" }
            %td.bot-sheet-table__text= game_t('admin.games.tournaments.match_number', number: match.position + 1)
            - if editable.call(match)
              %td= select_tag 'game_tournament_match[kind]', options_for_select(kind_options, match.kind), include_blank: game_t('admin.games.tournaments.pick_content'), form: form, id: nil, 'aria-label': game_t('admin.games.tournaments.content')
              %td= datetime_local_field_tag 'game_tournament_match[scheduled_at]', match.scheduled_at&.in_time_zone(seoul)&.strftime('%Y-%m-%dT%H:%M'), form: form, id: nil, 'aria-label': game_t('admin.games.tournaments.time')
              %td= select_tag 'game_tournament_match[player_a_id]', options_for_select(character_options, match.player_a_id), include_blank: game_t('admin.games.tournaments.pick_player'), form: form, id: nil, 'aria-label': game_t('admin.games.tournaments.player_a')
              %td= select_tag 'game_tournament_match[player_b_id]', options_for_select(character_options, match.player_b_id), include_blank: game_t('admin.games.tournaments.pick_player'), form: form, id: nil, 'aria-label': game_t('admin.games.tournaments.player_b')
            - else
              %td.bot-sheet-table__text= match.kind_name || '—'
              %td.bot-sheet-table__text= match.scheduled_at ? l(match.scheduled_at.in_time_zone(seoul), format: :short) : '—'
              - [match.player_a, match.player_b].each do |player|
                %td.bot-sheet-table__text
                  - if player
                    %span{ class: ('game-tournament__winner' if match.winner_id == player.id) }= GameCharacter.for(player).display_name
                  - else
                    \—
            %td.bot-sheet-table__text
              %span.game-badge{ class: "game-badge--match-#{match.status}" }= game_t("admin.games.tournaments.match_statuses.#{match.status}")
            %td.bot-sheet-table__actions
              - if editable.call(match)
                = button_tag material_symbol('check'), type: :submit, form: form, class: 'icon-button', title: t('generic.save_changes')
              - if %w(playing judging).include?(match.status) && match.players.size == 2
                - match.players.each do |player|
                  = button_to decide_admin_game_tournament_match_path(match), method: :post, params: { winner_id: player.id }, class: 'button button-secondary game-tournament__decide',
                              form_class: 'bot-sheet-table__delete', title: game_t('admin.games.tournaments.decide'), data: { confirm: game_t('admin.games.tournaments.decide_confirm', name: GameCharacter.for(player).display_name) } do
                    = game_t('admin.games.tournaments.win_by', name: GameCharacter.for(player).display_name)

= render layout: 'admin/game_characters/modal', locals: { id: 'tournament-edit', title: game_t('admin.games.tournaments.edit_info') } do
  = form_tag admin_game_tournament_path(@tournament), method: :patch, class: 'simple_form' do
    .input.with_label.string
      .label_input
        %label{ for: 'tournament_name' }= game_t('admin.games.tournaments.name')
        .label_input__wrapper= text_field_tag 'game_tournament[name]', @tournament.name, id: 'tournament_name', required: true
    .input.with_label.integer
      .label_input
        %label{ for: 'tournament_reward' }= game_t('admin.games.tournaments.reward')
        .label_input__wrapper= number_field_tag 'game_tournament[reward]', @tournament.reward, id: 'tournament_reward', min: 0
    .actions
      %button.button.button-tertiary{ type: 'button', data: { modal_close: true } }= t('generic.cancel')
      = button_tag t('generic.save_changes'), type: :submit, class: 'button'
