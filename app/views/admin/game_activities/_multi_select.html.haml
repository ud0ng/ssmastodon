-# 여러 개 고르는 드롭다운: 누르면 체크 목록이 펼쳐진다 (admin.tsx 가 고른 개수를 보여 주고 바깥을 누르면 닫는다)
-# options: [[보이는 이름, 값], ...], all_label: 있으면 맨 위에 '전체 선택'
%details.game-multi{ data: { multi_select: true, placeholder: placeholder } }
  %summary.game-multi__summary
    %span.game-multi__label= placeholder
    = material_symbol('arrow_drop_down')
  .game-multi__list
    - if options.empty?
      %p.hint= game_t('admin.games.activity.no_options')
    - else
      - if all_label
        %label.game-multi__option.game-multi__option--all
          = check_box_tag nil, '1', false, id: nil, data: { select_all: name }
          %strong= all_label
      - options.each do |label, value|
        %label.game-multi__option
          = check_box_tag name, value, false, id: nil, data: { label: label }
          = label
