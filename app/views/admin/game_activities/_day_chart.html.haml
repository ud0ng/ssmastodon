-# 일자별 툿 수 그래프(쌓은 막대): 캐릭터 한 명·전체·소속 어디든. 마우스를 올리면 말풍선으로 자세한 수가 뜬다 (CSS만, .act-chart)
-# local: days [[날짜, Game::ActivitySnapshot::Totals]] (오래된 날부터, 빈 날 포함)
-# 색은 서브색(--ct-point)에서 만든다: 퍼블 = 진하게, 답 = 중간, DM = 회색
- day_max = [days.map { |_, row| row.posts + row.dms }.max.to_i, 1].max
= render layout: 'admin/ui/section', locals: { title: game_t('admin.games.activity.chart_days'), hint: game_t('admin.games.activity.chart_days_hint', count: days.size) } do
  .act-chart__legend
    %span.act-chart__key.act-chart__key--public= game_t('admin.games.activity.posts')
    %span.act-chart__key.act-chart__key--reply= game_t('admin.games.activity.replies')
    %span.act-chart__key.act-chart__key--dm= game_t('admin.games.activity.dm_posts')
  - if days.all? { |_, row| row.posts + row.dms == 0 }
    %p.hint= game_t('admin.games.activity.no_data')
  - else
    .act-chart.act-chart--days
      .act-chart__axis
        %span= number_with_delimiter(day_max)
        %span= number_with_delimiter((day_max / 2.0).round)
        %span 0
      .act-chart__plot
        - days.each_with_index do |(day, row), index|
          - public_only = row.public_posts
          - replies = row.reply_posts
          - dms = row.dms
          %div.act-chart__col{ class: ('act-chart__col--end' if index > days.size * 2 / 3), tabindex: 0 }
            .act-chart__stack{ style: "height: #{((public_only + replies + dms) * 100.0 / day_max).round(1)}%" }
              - { 'dm' => dms, 'reply' => replies, 'public' => public_only }.each do |kind, value|
                - next if value.zero?
                %span.act-chart__seg{ class: "act-chart__seg--#{kind}", style: "flex-grow: #{value}" }
            .act-chart__tip
              %strong= l(day, format: '%m-%d (%a)')
              %span.act-chart__line.act-chart__line--public= "#{game_t('admin.games.activity.posts')} #{row.public_posts} / #{number_with_delimiter(row.public_chars)}"
              %span.act-chart__line.act-chart__line--reply= "#{game_t('admin.games.activity.replies')} #{row.reply_posts} / #{number_with_delimiter(row.reply_chars)}"
              %span.act-chart__line.act-chart__line--dm= "#{game_t('admin.games.activity.dm_posts')} #{row.dms} / #{number_with_delimiter(row.dm_chars)}"
              %span.act-chart__line= "#{game_t('admin.games.activity.reply_count')} #{row.reply_turns} · #{game_t('admin.games.activity.media')} #{row.media} · #{game_t('admin.games.activity.skipped')} #{row.skipped}"
            %span.act-chart__label= day.day == 1 || index.zero? ? l(day, format: '%-m/%-d') : day.day
