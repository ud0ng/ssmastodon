- content_for :page_title do
  = game_t('admin.games.manage.tabs.activity')

- content_for :heading do
  = render 'admin/game_characters/heading'

-# 퍼블 툿·답 툿 (DM·부스트 빼고), 글자 수, 가진 재화. 줄을 누르면 상세. 목록 위 [지급]
- give = button_tag safe_join([material_symbol('celebration'), game_t('admin.games.activity.give')]), type: :button, class: 'button', data: { modal_open: 'activity-give' }
= render layout: 'admin/ui/section', locals: { title: game_t('admin.games.manage.tabs.activity'), hint: game_t('admin.games.activity.hint'), actions: give } do
  .bot-sheet-table.game-table
    %table.table
      %thead
        %tr
          %th= game_t('admin.games.manage.roster.name')
          %th= game_t('admin.games.manage.roster.acct')
          %th.game-table__number= game_t('admin.games.activity.posts')
          %th.game-table__number= game_t('admin.games.activity.post_chars')
          %th.game-table__number= game_t('admin.games.activity.replies')
          %th.game-table__number= game_t('admin.games.activity.reply_chars')
          %th.game-table__number= @currency
      %tbody
        - @characters.each do |character|
          - stats = @stats[character.account_id]
          %tr.game-table__row{ data: { href: admin_game_activity_path(character) } }
            %td.bot-sheet-table__text.game-table__name-cell
              = link_to admin_game_activity_path(character), class: 'game-table__name' do
                = image_tag full_asset_url(character.account.avatar_static_url), alt: '', class: 'game-table__avatar'
                %strong= character.display_name
            %td.bot-sheet-table__text= "@#{character.account.username}"
            %td.game-table__number= number_with_delimiter(stats.posts)
            %td.game-table__number= number_with_delimiter(stats.post_chars)
            %td.game-table__number= number_with_delimiter(stats.replies)
            %td.game-table__number= number_with_delimiter(stats.reply_chars)
            %td.game-table__number= number_with_delimiter(character.money)
        - if @characters.empty?
          %tr
            %td.bot-sheet-table__text{ colspan: 7 }= game_t('admin.games.manage.roster.empty')

= render 'admin/game_activities/give_modal', return_to: admin_game_activities_path
