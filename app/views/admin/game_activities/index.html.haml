- content_for :page_title do
  = game_t('admin.games.manage.tabs.activity')

- content_for :heading do
  = render 'admin/game_characters/heading'

-# 일일 활동 스냅샷(Game::ActivitySnapshot)으로 보는 일자별 통계: 전체 / 소속별 / 캐릭터별. 기간을 고르고, 캐릭터별에서 줄을 누르면 그 캐릭터의 일자별·상대 캐릭터별 통계.
= render 'admin/ui/subtabs', label: game_t('admin.games.manage.tabs.activity'),
  items: Admin::GameActivitiesController::VIEWS.map { |name| [game_t("admin.games.activity.views.#{name}"), admin_game_activities_path(request.query_parameters.except('sort', 'dir', 'page').merge('view' => name)), view_name == name, false] }

- if Game::ActivitySnapshot.built_through.nil?
  %p.hint= game_t('admin.games.activity.building')

= render 'admin/game_activities/range', url: admin_game_activities_path, keep: { view: view_name, house: @filter_house&.id }

- backfill = button_to game_t('admin.games.activity.backfill'), backfill_admin_game_activities_path, method: :post, class: 'button button-secondary', form_class: 'inline-form', data: { confirm: game_t('admin.games.activity.backfill_confirm') }
- give = button_tag safe_join([material_symbol('celebration'), game_t('admin.games.activity.give')]), type: :button, class: 'button', data: { modal_open: 'activity-give' }

- if view_name == 'total'
  -# 일자별: 모든 캐릭터(또는 고른 소속) 합계. 맨 위는 기간 합계
  - title = @filter_house ? game_t('admin.games.activity.total_of', name: @filter_house.name) : game_t('admin.games.activity.total_title')
  = render 'admin/game_activities/day_chart', days: @chart_days

  = render layout: 'admin/ui/section', locals: { title: title, hint: game_t('admin.games.activity.hint'), actions: backfill } do
    .bot-sheet-table.game-table.game-table--scroll
      %table.table
        %thead
          %tr
            %th= game_sort_header(game_t('admin.games.activity.date'), 'date', *sort_state(:days))
            = render 'admin/game_activities/totals_head', table: :days
        %tbody
          %tr.game-table__total
            %td.bot-sheet-table__text
              %strong= game_t('admin.games.activity.sum_row')
            = render 'admin/game_activities/totals_cells', totals: @total
          - @daily.each do |day, totals|
            %tr
              %td.bot-sheet-table__text.game-table__time= l(day, format: '%Y-%m-%d (%a)')
              = render 'admin/game_activities/totals_cells', totals: totals
          - if @daily.empty?
            %tr
              %td.bot-sheet-table__text{ colspan: 7 }= game_t('admin.games.activity.no_data')

- elsif view_name == 'house'
  = render layout: 'admin/ui/section', locals: { title: game_t('admin.games.activity.house_title'), hint: game_t('admin.games.activity.house_hint'), actions: backfill } do
    .bot-sheet-table.game-table.game-table--scroll
      %table.table
        %thead
          %tr
            %th= game_sort_header(game_t('admin.games.activity.house_name'), 'name', *sort_state(:houses))
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.members'), 'members', *sort_state(:houses))
            = render 'admin/game_activities/totals_head', table: :houses
        %tbody
          - @house_rows.each do |house, count, totals|
            - path = house ? admin_game_activities_path(view: 'total', house: house.id, range: range_name, from: params[:from], to: params[:to]) : nil
            %tr.game-table__row{ data: { href: path } }
              %td.bot-sheet-table__text
                - if house
                  = link_to path, class: 'game-table__name' do
                    %span.game-badge{ style: "--badge: #{house.color.presence || '#6b5b3e'}" }= house.name
                - else
                  = game_t('admin.games.manage.none')
              %td.game-table__number= number_with_delimiter(count)
              = render 'admin/game_activities/totals_cells', totals: totals
          - if @house_rows.empty?
            %tr
              %td.bot-sheet-table__text{ colspan: 8 }= game_t('admin.games.manage.roster.empty')

- else
  -# 캐릭터별: 맨 위 경고 기준
  = render layout: 'admin/ui/section', locals: { title: game_t('admin.games.activity.criteria_title'), hint: game_t('admin.games.activity.criteria_hint') } do
    = form_tag criteria_admin_game_activities_path, method: :patch, class: 'simple_form' do
      = render layout: 'admin/ui/fields' do
        = render 'admin/ui/field', label: game_t('admin.games.activity.criteria_hours'), name: 'activity_hours', id: 'activity_hours', value: @criteria[:hours], type: :number,
                                   hint: game_t('admin.games.activity.hours_hint'), html: { min: 1, max: 24 }
        = render 'admin/ui/field', label: game_t('admin.games.activity.criteria_partners'), name: 'activity_min_partners', id: 'activity_min_partners', value: @criteria[:min_partners], type: :number, html: { min: 0 }
      .actions
        = button_tag t('generic.save_changes'), type: :submit, class: 'button'

  = render layout: 'admin/ui/section', locals: { title: game_t('admin.games.manage.tabs.activity'), hint: game_t('admin.games.activity.hint'), actions: safe_join([backfill, give]) } do
    .bot-sheet-table.game-table.game-table--fit
      %table.table
        %thead
          %tr
            %th= game_sort_header(game_t('admin.games.manage.roster.name'), 'name', sort_column, sort_direction)
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.all_posts'), 'posts', sort_column, sort_direction)
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.dm_posts'), 'dms', sort_column, sort_direction)
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.posts'), 'public_posts', sort_column, sort_direction)
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.replies'), 'reply_posts', sort_column, sort_direction)
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.reply_count'), 'replies', sort_column, sort_direction)
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.partners'), 'partners', sort_column, sort_direction)
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.last_reply'), 'last_reply', sort_column, sort_direction)
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.media'), 'media', sort_column, sort_direction)
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.skipped'), 'skipped', sort_column, sort_direction)
        %tbody
          - @characters.each do |character|
            - totals = @totals[character.account_id]
            - path = stats_admin_game_activity_path(character, range: range_name, from: params[:from], to: params[:to])
            %tr.game-table__row{ data: { href: path } }
              = render 'admin/game_characters/name_cell', character: character, path: path
              = render 'admin/game_activities/totals_cells', totals: totals, media: false
              -# 경고: 마지막 답 툿이 기준 시간보다 오래됐거나, 기준 시간 안에 교류한 캐릭터가 모자라면 붉게
              - alert = @alerts[character.account_id]
              - late = alert.last_reply_at.nil? || alert.last_reply_at < @criteria[:hours].hours.ago
              %td.game-table__number{ class: ('game-alert' if alert.partners < @criteria[:min_partners]) }= game_t('admin.games.activity.partners_value', count: alert.partners)
              %td.game-table__number{ class: ('game-alert' if late) }= game_ago(alert.last_reply_at)
              %td.game-table__number= number_with_delimiter(totals.media)
              %td.game-table__number= number_with_delimiter(totals.skipped)
          - if @characters.empty?
            %tr
              %td.bot-sheet-table__text{ colspan: 11 }= game_t('admin.games.manage.roster.empty')

= render 'admin/game_activities/give_modal', return_to: admin_game_activities_path
