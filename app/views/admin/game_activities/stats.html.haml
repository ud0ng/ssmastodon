- content_for :page_title do
  = game_t('admin.games.activity.stats_title', name: @character.display_name)

- content_for :heading do
  = render 'admin/game_characters/heading'

-# 한 캐릭터: 탭 일자별 / 상대 캐릭터별 / 활동 기록(검색 화면으로)
- period = { range: range_name, from: params[:from], to: params[:to] }.compact_blank
= render 'admin/ui/subtabs', label: game_t('admin.games.activity.stats_title', name: @character.display_name),
  items: [[game_t('admin.games.activity.tab_days'), stats_admin_game_activity_path(@character, period.merge(tab: 'days')), @tab == 'days', false],
          [game_t('admin.games.activity.tab_pairs'), stats_admin_game_activity_path(@character, period.merge(tab: 'pairs')), @tab == 'pairs', false],
          [game_t('admin.games.activity.tab_logs'), admin_game_activity_logs_path(character: @character.account_id), false, false]]

= render 'admin/game_activities/range', url: stats_admin_game_activity_path(@character), keep: { tab: @tab, opponent: (@opponent&.account_id if @tab == 'pairs') }

- if @tab == 'days'
  = render 'admin/game_activities/day_chart', days: @chart_days

  = render layout: 'admin/ui/section', locals: { title: game_t('admin.games.activity.stats_daily', name: @character.display_name) } do
    .bot-sheet-table.game-table.game-table--scroll
      %table.table
        %thead
          %tr
            %th= game_sort_header(game_t('admin.games.activity.date'), 'date', *sort_state(:days))
            = render 'admin/game_activities/totals_head', table: :days
        %tbody
          %tr.game-table__total
            %td.bot-sheet-table__text
              %strong= game_t('admin.games.activity.sum_row')
            = render 'admin/game_activities/totals_cells', totals: @total
          - @daily.each do |day, totals|
            %tr
              %td.bot-sheet-table__text.game-table__time= l(day, format: '%Y-%m-%d (%a)')
              = render 'admin/game_activities/totals_cells', totals: totals
          - if @daily.empty?
            %tr
              %td.bot-sheet-table__text{ colspan: 8 }= game_t('admin.games.activity.no_data')

- else
  -# 상대 캐릭터별 (편애·차별 보기, Game::Fairness): 지수는 이 캐릭터의 평균 = 1.0
  - turn_total = @my_total.reply_turns
  = render layout: 'admin/ui/section', locals: { title: game_t('admin.games.activity.ratio_title') } do
    .act-ratio__grid
      = render 'admin/game_activities/rate_chart', title: game_t('admin.games.activity.rate_overall'), unit: 'scale', mark: 1.0, mark_label: game_t('admin.games.activity.mark_average'),
                                                  entries: @pairs.filter_map { |other, row| (score = @scores[other.account_id]).overall && [other.display_name, score.overall, game_t('admin.games.activity.times', value: score.overall), score.basis] }
      = render 'admin/game_activities/rate_chart', title: game_t('admin.games.activity.rate_interest'), unit: 'scale', mark: 1.0, mark_label: game_t('admin.games.activity.mark_fair'),
                                                  entries: @pairs.filter_map { |other, row| (score = @scores[other.account_id]).interest && [other.display_name, score.interest, game_t('admin.games.activity.times', value: score.interest), row.reply_turns] }
      = render 'admin/game_activities/rate_chart', title: game_t('admin.games.activity.rate_chars'), unit: 'scale', mark: @my_total.avg_chars, mark_label: (@my_total.avg_chars && game_t('admin.games.activity.mark_mine', value: game_t('admin.games.activity.avg_chars_short', count: @my_total.avg_chars))),
                                                  entries: @pairs.filter_map { |other, row| row.avg_chars && [other.display_name, row.avg_chars, game_t('admin.games.activity.avg_chars_short', count: number_with_delimiter(row.avg_chars)), row.reply_posts] }
      = render 'admin/game_activities/rate_chart', title: game_t('admin.games.activity.rate_skip'), unit: 'percent', mark: @my_total.skip_rate, mark_label: (@my_total.skip_rate && game_t('admin.games.activity.mark_mine', value: "#{@my_total.skip_rate}%")),
                                                  entries: @pairs.filter_map { |other, row| row.skip_rate && [other.display_name, row.skip_rate, "#{row.skip_rate}%", row.reply_turns + row.skipped] }

  = render layout: 'admin/ui/section', locals: { title: game_t('admin.games.activity.pairs_title') } do
    .bot-sheet-table.game-table.game-table--scroll.act-fair-table
      %table.table
        %thead
          %tr
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.rank'), 'rank', *sort_state(:pairs), param: 'psort', dir_param: 'pdir')
            %th= game_sort_header(game_t('admin.games.records.opponent'), 'name', *sort_state(:pairs), param: 'psort', dir_param: 'pdir')
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.overall'), 'overall', *sort_state(:pairs), param: 'psort', dir_param: 'pdir')
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.replies'), 'reply_posts', *sort_state(:pairs), param: 'psort', dir_param: 'pdir')
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.pair_reply_chars'), 'reply_chars', *sort_state(:pairs), param: 'psort', dir_param: 'pdir')
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.media'), 'media', *sort_state(:pairs), param: 'psort', dir_param: 'pdir')
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.reply_count'), 'replies', *sort_state(:pairs), param: 'psort', dir_param: 'pdir')
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.dm_posts'), 'dms', *sort_state(:pairs), param: 'psort', dir_param: 'pdir')
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.pair_dm_chars'), 'dm_chars', *sort_state(:pairs), param: 'psort', dir_param: 'pdir')
            %th.game-table__number= game_sort_header(game_t('admin.games.activity.skipped'), 'skipped', *sort_state(:pairs), param: 'psort', dir_param: 'pdir')
        %tbody
          - @pairs.each do |other, row|
            - path = stats_admin_game_activity_path(@character, period.merge(tab: 'pairs', opponent: other.account_id, psort: params[:psort], pdir: params[:pdir]).compact_blank)
            %tr.game-table__row{ class: ('is-selected' if @opponent == other), data: { href: path } }
              %td.game-table__number.act-rank= @ranks[other.account_id]
              = render 'admin/game_characters/name_cell', character: other, path: path
              = render 'admin/game_activities/fair_cell', score: @scores[other.account_id]
              = render 'admin/game_activities/pair_cells', row: row, ratios: true, turn_total: turn_total
            -# 아래 줄: 상대 → 이 캐릭터 (같은 기간, 지수는 그 상대 자신의 평균과 견준다)
            - back = @pairs_back[other.account_id] || Game::ActivitySnapshot::PairTotals.empty
            %tr.game-table__sub.game-table__back{ data: { href: path } }
              %td
              %td.bot-sheet-table__text
                %span.act-back
                  %svg.act-back__arrow{ viewBox: '0 0 24 24', width: 14, height: 14, fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': true }
                    %path{ d: 'M5 12l14 0' }
                    %path{ d: 'M5 12l6 6' }
                    %path{ d: 'M5 12l6 -6' }
                  = image_tag(full_asset_url(other.account.avatar_static_url), alt: '', class: 'act-back__avatar')
                  %span= other.display_name
              = render 'admin/game_activities/fair_cell', score: @back_scores[other.account_id]
              = render 'admin/game_activities/pair_cells', row: back, ratios: true
          - if @pairs.empty?
            %tr
              %td.bot-sheet-table__text{ colspan: 10 }= game_t('admin.games.activity.no_data')

  - if @opponent
    = render layout: 'admin/ui/section', locals: { title: game_t('admin.games.activity.pair_daily', name: @character.display_name, other: @opponent.display_name), hint: game_t('admin.games.activity.pair_daily_hint', other: @opponent.display_name, name: @character.display_name) } do
      = render 'admin/game_activities/pair_day_chart', rows: @pair_days, me: @character, other: @opponent
      .bot-sheet-table.game-table.game-table--fit
        %table.table
          %thead
            %tr
              %th= game_sort_header(game_t('admin.games.activity.date'), 'date', *sort_state(:pair_days), param: 'dsort', dir_param: 'ddir')
              %th.game-table__number= game_sort_header(game_t('admin.games.activity.replies'), 'reply_posts', *sort_state(:pair_days), param: 'dsort', dir_param: 'ddir')
              %th.game-table__number= game_sort_header(game_t('admin.games.activity.pair_reply_chars'), 'reply_chars', *sort_state(:pair_days), param: 'dsort', dir_param: 'ddir')
              %th.game-table__number= game_sort_header(game_t('admin.games.activity.media'), 'media', *sort_state(:pair_days), param: 'dsort', dir_param: 'ddir')
              %th.game-table__number= game_sort_header(game_t('admin.games.activity.reply_count'), 'replies', *sort_state(:pair_days), param: 'dsort', dir_param: 'ddir')
              %th.game-table__number= game_sort_header(game_t('admin.games.activity.dm_posts'), 'dms', *sort_state(:pair_days), param: 'dsort', dir_param: 'ddir')
              %th.game-table__number= game_sort_header(game_t('admin.games.activity.pair_dm_chars'), 'dm_chars', *sort_state(:pair_days), param: 'dsort', dir_param: 'ddir')
              %th.game-table__number= game_sort_header(game_t('admin.games.activity.skipped'), 'skipped', *sort_state(:pair_days), param: 'dsort', dir_param: 'ddir')
          %tbody
            - [[nil, @pair_mine, @pair_theirs]].concat(@pair_days).each do |day, mine, theirs|
              %tr{ class: ('game-table__total' if day.nil?) }
                %td.bot-sheet-table__text.game-table__time
                  - if day.nil?
                    %strong= game_t('admin.games.activity.sum_row')
                  - else
                    = l(day, format: '%Y-%m-%d (%a)')
                  %small.hint= "#{@character.display_name} → #{@opponent.display_name}"
                = render 'admin/game_activities/pair_cells', row: mine
              %tr.game-table__sub
                %td.bot-sheet-table__text
                  %small.hint= "↳ #{@opponent.display_name} → #{@character.display_name}"
                = render 'admin/game_activities/pair_cells', row: theirs
            - if @pair_days.empty?
              %tr
                %td.bot-sheet-table__text{ colspan: 8 }= game_t('admin.games.activity.no_data')
