.content__heading__tabs
  = render_navigation renderer: :links do |primary|
    :ruby
      primary.item :branding, safe_join([material_symbol('description'), t('admin.settings.tabs.info')]), admin_settings_branding_path, highlights_on: %r{/admin/settings/(branding|about)}
      primary.item :registrations, safe_join([material_symbol('tune'), t('admin.settings.tabs.operations')]), admin_settings_registrations_path, highlights_on: %r{/admin/settings/(registrations|discovery|content_retention|community$)}
      primary.item :community_theme, safe_join([material_symbol('palette'), t('admin.settings.tabs.design')]), admin_settings_community_theme_path, highlights_on: %r{/admin/settings/(community_theme|appearance)}
