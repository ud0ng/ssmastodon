- content_for :page_title do
  = t('admin.settings.community.title')

- content_for :heading do
  = render partial: 'admin/settings/shared/heading'

= simple_form_for @admin_settings, url: admin_settings_community_path, html: { id: 'edit_admin_settings', method: :patch } do |f|
  = render 'shared/error_messages', object: @admin_settings

  %h4= t('admin.settings.community.posting')

  .fields-group
    = f.input :status_max_characters,
              input_html: { type: 'number', min: StatusLengthValidator::MAX_CHARS_RANGE.min, max: StatusLengthValidator::MAX_CHARS_RANGE.max },
              wrapper: :with_block_label

  %h4= t('admin.settings.community.search')

  .fields-group
    = f.input :status_search_enabled,
              as: :boolean,
              wrapper: :with_label

  .fields-group
    = f.input :status_search_scope,
              collection: Form::AdminSettings::STATUS_SEARCH_SCOPES,
              include_blank: false,
              label_method: ->(scope) { I18n.t("admin.settings.community.search_scopes.#{scope}") },
              wrapper: :with_label

  %h4= t('admin.settings.community.theme')
  %p.hint= t('admin.settings.community.theme_hint_html', branding_path: admin_settings_branding_path)

  .fields-group
    = f.input :community_theme_enabled,
              as: :boolean,
              wrapper: :with_label

  .fields-group
    = f.input :community_theme_default,
              collection: Themes::COMMUNITY_THEME_MODES,
              include_blank: false,
              label_method: ->(mode) { I18n.t("themes.community-#{mode}") },
              wrapper: :with_label

  - color_input = { pattern: '#[0-9a-fA-F]{6}', maxlength: 7 }
  - (light_main, light_point), (dark_main, dark_point) = community_theme_colors.values_at(:light, :dark)

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :community_theme_main_light,
                input_html: color_input.merge(placeholder: ThemeHelper::COMMUNITY_THEME_DEFAULT_COLOR, data: { color_picker: light_main }),
                wrapper: :with_label
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :community_theme_point_light,
                input_html: color_input.merge(placeholder: t('admin.settings.community.same_as_main'), data: { color_picker: light_point }),
                wrapper: :with_label

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :community_theme_main_dark,
                input_html: color_input.merge(placeholder: t('admin.settings.community.same_as_light'), data: { color_picker: dark_main }),
                wrapper: :with_label
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :community_theme_point_dark,
                input_html: color_input.merge(placeholder: t('admin.settings.community.lighter_main'), data: { color_picker: dark_point }),
                wrapper: :with_label

  .fields-group
    = f.input :community_theme_post_button_main,
              as: :boolean,
              wrapper: :with_label

  .image-picker
    - SiteUpload::COMMUNITY_THEME_BACKGROUND_VARS.each do |var|
      = render partial: 'admin/settings/shared/upload', locals: { f: f, attribute: var.to_sym, upload: @admin_settings.public_send(var), frame: 'thumbnail', size: :community_theme_background }
