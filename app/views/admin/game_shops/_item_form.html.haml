-# 상점 아이템 추가·수정 모달: 아이템 설명(이미지·이름·가격·설명·효과 설명) / 옵션([사용]·[선물]·[영구]) / 효과(상자 여러 개, admin.tsx setupItemEffects)
- shops = GameShop.all.map { |shop| [shop.name, shop.id] }
- prefix = item.persisted? ? "item_#{item.id}" : 'item_new'
- stats = GameCharacterField.stats.map { |field| ["#{field.name} (#{field.stat? ? I18n.t('admin.games.shop.stat_temporary') : I18n.t('admin.games.shop.stat_permanent')})", field.name] }
- box = { stats: stats, shop_items: GameShopItem.pluck(:name).map { |name| [name, name] }, fx_effects: GameEffect.all.to_a, counters: GameCounter.all.to_a, currency: @currency }
= form_tag url, method: method, multipart: true, class: 'simple_form game-item-form', id: "#{prefix}_form" do
  %h5.ui-subtitle= game_t('admin.games.item_fx.section_item')
  .game-item-form__item
    = render 'admin/ui/image_picker', name: 'game_shop_item[image]', id: "#{prefix}_image", remove_name: 'game_shop_item[remove_image]', label: game_t('admin.games.shop.image'),
                                      image: item.image.present? ? item.image.url(:small) : nil, accept: GameShopItem::IMAGE_MIME_TYPES.join(',')
    .game-item-form__item-fields
      = render layout: 'admin/ui/fields', locals: { columns: 2 } do
        = render 'admin/ui/field', label: game_t('admin.games.shop.item_name'), name: 'game_shop_item[name]', id: "#{prefix}_name", value: item.name, required: true, html: { maxlength: 50 }
        = render 'admin/ui/field', label: game_t('admin.games.shop.price', currency: @currency), name: 'game_shop_item[price]', id: "#{prefix}_price", value: item.price, type: :number,
                                   hint: game_t('admin.games.shop.price_hint'), html: { min: 0 }
      - if shops.size > 1
        = render 'admin/ui/field', label: game_t('admin.games.shop.shop_name'), name: 'game_shop_item[game_shop_id]', id: "#{prefix}_shop", value: item.game_shop_id, type: :select, options: shops
      - else
        = hidden_field_tag 'game_shop_item[game_shop_id]', item.game_shop_id || shops.first&.last, id: nil
  = render 'admin/ui/field', label: game_t('admin.games.shop.description'), name: 'game_shop_item[description]', id: "#{prefix}_description", value: item.description, type: :textarea, html: { rows: 2, maxlength: 1000 }
  = render 'admin/ui/field', label: game_t('admin.games.shop.effect'), name: 'game_shop_item[effect]', id: "#{prefix}_effect", value: item.effect, type: :textarea, hint: game_t('admin.games.shop.effect_hint'), html: { rows: 2, maxlength: 1000 }

  %h5.ui-subtitle= game_t('admin.games.item_fx.section_options')
  = render 'admin/ui/checks', id_suffix: prefix, items: [[game_t('admin.games.item_fx.usable'), 'game_shop_item[usable]', item.usable],
                                                        [game_t('admin.games.item_fx.giftable'), 'game_shop_item[giftable]', item.giftable],
                                                        [game_t('admin.games.item_fx.permanent'), 'game_shop_item[permanent]', item.permanent]]

  %h5.ui-subtitle= game_t('admin.games.item_fx.section_effects')
  %p.hint= game_t('admin.games.item_fx.hint')
  = hidden_field_tag 'game_shop_item[item_effects_sent]', '1', id: nil
  .ui-effect-list{ data: { effect_list: true } }
    - item.effects_list.each_with_index do |effect, index|
      = render 'admin/game_shops/effect_box', index: index, effect: effect, **box
  %template{ data: { effect_template: true } }
    = render 'admin/game_shops/effect_box', index: '__INDEX__', effect: {}, **box
  = button_tag safe_join([material_symbol('add'), game_t('admin.games.item_fx.add')]), type: :button, class: 'button button-secondary ui-effect-list__add', data: { effect_add: true }
  = render 'admin/ui/modal_actions'
