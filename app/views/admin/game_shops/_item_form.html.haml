-# 상점 아이템 추가·수정: 그림 · 이름 · 설명 · 금액(비우면 비매품), 그 아래 분류(상점이 여럿일 때)·사용 가능·[사용] 때 바뀌는 스탯과 수치
- shops = GameShop.all.map { |shop| [shop.name, shop.id] }
- stats = [[game_t('admin.games.shop.no_stat'), '']] + @base_stats.map { |name| [name, name] }
- prefix = item.persisted? ? "item_#{item.id}" : 'item_new'
= form_tag url, method: method, multipart: true, class: 'simple_form', id: "#{prefix}_form" do
  = render layout: 'admin/ui/field', locals: { label: game_t('admin.games.shop.image'), id: "#{prefix}_image", type: :custom, hint: game_t('admin.games.shop.image_hint'), wide: true } do
    .game-item-image-field
      = render 'admin/game_characters/item_thumb', name: item.name.presence || '?', image: item.image.present? ? item.image.url(:small) : nil
      .game-item-image-field__inputs
        = file_field_tag 'game_shop_item[image]', id: "#{prefix}_image", accept: GameShopItem::IMAGE_MIME_TYPES.join(','), class: 'ui-input ui-input--file'
        - if item.image.present?
          %label.game-item-image-field__remove
            = check_box_tag 'game_shop_item[remove_image]', '1', false, id: "#{prefix}_remove_image"
            = game_t('admin.games.shop.remove_image')
  = render 'admin/ui/field', label: game_t('admin.games.shop.item_name'), name: 'game_shop_item[name]', id: "#{prefix}_name", value: item.name, required: true, wide: true, html: { maxlength: 50 }
  = render 'admin/ui/field', label: game_t('admin.games.shop.description'), name: 'game_shop_item[description]', id: "#{prefix}_description", value: item.description, type: :textarea, html: { rows: 2, maxlength: 1000 }
  = render layout: 'admin/ui/fields', locals: { columns: 2 } do
    = render 'admin/ui/field', label: game_t('admin.games.shop.price', currency: @currency), name: 'game_shop_item[price]', id: "#{prefix}_price", value: item.price, type: :number,
                               hint: game_t('admin.games.shop.price_hint'), html: { min: 0 }
    - if shops.size > 1
      = render 'admin/ui/field', label: game_t('admin.games.shop.shop_name'), name: 'game_shop_item[game_shop_id]', id: "#{prefix}_shop", value: item.game_shop_id, type: :select, options: shops
    - else
      = hidden_field_tag 'game_shop_item[game_shop_id]', item.game_shop_id || shops.first&.last, id: nil
  = render 'admin/ui/switch', label: game_t('admin.games.shop.usable'), name: 'game_shop_item[usable]', id: "#{prefix}_usable", checked: item.usable
  = render layout: 'admin/ui/fields', locals: { columns: 2 } do
    = render 'admin/ui/field', label: game_t('admin.games.shop.stat'), name: 'game_shop_item[stat_name]', id: "#{prefix}_stat", value: item.stat_name.to_s, type: :select, options: stats
    = render 'admin/ui/field', label: game_t('admin.games.shop.value'), name: 'game_shop_item[stat_value]', id: "#{prefix}_value", value: item.stat_value,
                               hint: game_t('admin.games.shop.value_hint'), placeholder: '5, -20, 1d10'
  = render 'admin/ui/modal_actions'
