-# 수치 종류: 이름 · 최대 누적치(비우면 제한 없음) · 상성 수치(서로 상쇄) · 소속 점수에 영향(켜면 시간 간격·점수)
- key = counter.id || 'new'
- forced = counter.opposite&.affects_house
- house_on = counter.affects_house || forced
- minutes = counter.house_interval_minutes.to_i.positive? ? counter.house_interval_minutes : 60
- interval_unit, interval = if (minutes % 1440).zero? then ['day', minutes / 1440] elsif (minutes % 60).zero? then ['hour', minutes / 60] else ['minute', minutes] end
- house_units = [[game_t('admin.games.item_fx.minute'), 'minute'], [game_t('admin.games.item_fx.hour'), 'hour'], [game_t('admin.games.item_fx.day'), 'day']]
= form_tag url, method: method, class: 'simple_form', data: { counter_house: true } do
  = render 'admin/ui/field', label: game_t('admin.games.counters.name'), name: 'game_counter[name]', id: "counter_#{counter.id || 'new'}_name", value: counter.name, required: true, wide: true, html: { maxlength: 20 }
  = render layout: 'admin/ui/fields', locals: { columns: 2 } do
    = render 'admin/ui/field', label: game_t('admin.games.counters.max_count'), name: 'game_counter[max_count]', id: "counter_#{counter.id || 'new'}_max", value: counter.max_count, type: :number,
                               hint: game_t('admin.games.counters.max_count_hint'), html: { min: 1 }
    = render 'admin/ui/field', label: game_t('admin.games.counters.opposite'), name: 'game_counter[opposite_id]', id: "counter_#{counter.id || 'new'}_opposite", value: counter.opposite_id, type: :select,
                               options: GameCounter.where.not(id: counter.id).map { |other| [other.name, other.id] }, include_blank: game_t('admin.games.counters.no_opposite'), hint: game_t('admin.games.counters.opposite_hint')
  = render 'admin/ui/switch', label: game_t('admin.games.counters.affects_house'), name: 'game_counter[affects_house]', id: "counter_#{key}_house", checked: house_on, data: { house_toggle: true },
                              hint: forced ? game_t('admin.games.counters.affects_forced') : game_t('admin.games.counters.affects_house_hint')
  %div{ data: { house_part: true }, hidden: !house_on }
    = render layout: 'admin/ui/fields', locals: { columns: 3 } do
      = render 'admin/ui/field', label: game_t('admin.games.counters.house_interval'), name: 'game_counter[house_interval]', id: "counter_#{key}_interval", value: interval, type: :number, html: { min: 1 }, disabled: !house_on
      = render 'admin/ui/field', label: game_t('admin.games.item_fx.unit'), name: 'game_counter[house_unit]', id: "counter_#{key}_unit", value: interval_unit, type: :select, options: house_units
      = render 'admin/ui/field', label: game_t('admin.games.counters.house_amount'), name: 'game_counter[house_amount]', id: "counter_#{key}_amount", value: counter.house_amount, type: :number, html: { step: 1 },
                                 hint: game_t('admin.games.counters.house_amount_hint')
  = render 'admin/ui/modal_actions'
